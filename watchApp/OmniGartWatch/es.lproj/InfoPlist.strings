/* es — Watch HealthKit, Bluetooth, camera, notifications */
"NSHealthShareUsageDescription" = "OmniGart en Apple Watch lee la frecuencia cardiaca, la VFC, los entrenamientos y la energía activa y en reposo desde Apple Health para mostrar estimaciones de bienestar en el reloj. Si una muestra se elimina después de Apple Health, OmniGart conserva tu copia en el dispositivo. Los datos de salud no se usan para publicidad ni se comparten con terceros.";
"NSHealthUpdateUsageDescription" = "OmniGart en Apple Watch guarda entrenamientos de fuerza, yoga, Pilates y zona 2 — con duración, energía activa y en reposo, frecuencia cardiaca y segmentos — en Apple Health para que aparezcan en Fitness. Las escrituras solo añaden: OmniGart nunca elimina ni reescribe datos de Apple Health, incluidos los suyos; las ediciones posteriores permanecen en OmniGart. Los datos no se usan para anuncios ni se venden.";
"NSBluetoothAlwaysUsageDescription" = "OmniGart puede usar Bluetooth durante una carrera indoor en cinta para leer velocidad, inclinación y distancia de una cinta compatible, y para accesorios de frecuencia cardiaca que elijas. La app del reloj sigue siendo usable sin accesorio.";
"NSCameraUsageDescription" = "La cámara no es necesaria en Apple Watch para OmniGart; esta descripción existe por las cadenas de permisos compartidas con la app del iPhone.";
"NSUserNotificationsUsageDescription" = "OmniGart puede recordarte entrenamientos y revisiones de bienestar que actives. La app funciona con las notificaciones desactivadas.";
