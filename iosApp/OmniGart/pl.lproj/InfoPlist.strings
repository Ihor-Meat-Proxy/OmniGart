/* pl — HealthKit, Bluetooth, camera, notifications purpose strings */
"NSHealthShareUsageDescription" = "OmniGart odczytuje tętno, HRV, sen, treningi, aktywną i spoczynkową energię, regenerację tętna, wysiłek treningowy, minuty uważności (gdy je włączysz), masę ciała i powiązane próbki wellness z Apple Health, aby pokazywać gotowość, regenerację i szacunki treningu na Twoim urządzeniu. Jeśli próbka zostanie później usunięta z Apple Health, OmniGart zachowuje kopię na urządzeniu. Dane zdrowotne zostają na Twoich urządzeniach i nie są wykorzystywane do reklam ani sprzedawane stronom trzecim.";
"NSHealthUpdateUsageDescription" = "OmniGart zapisuje treningi siłowe, jogę, pilates, strefę 2 oraz biegi na bieżni — z czasem trwania, aktywną i spoczynkową energią, tętnem, dystansem z połączonej bieżni gdy dostępny, segmentami oraz wynikami regeneracji lub wysiłku — a także opcjonalne minuty uważności i wybrane metryki wellness do Apple Health, aby pojawiały się w Fitness. Zapis jest tylko dołączający: OmniGart nigdy nie usuwa ani nie nadpisuje danych Apple Health, także własnych; późniejsze edycje zostają w OmniGart. Nic nie trafia do reklamodawców ani niezwiązanych stron trzecich.";
"NSBluetoothAlwaysUsageDescription" = "OmniGart używa Bluetooth do łączenia z bieżniami i akcesoriami do pomiaru tętna, które wybierzesz, aby na żywo pokazywać prędkość, nachylenie i dystans w Biegu na bieżni oraz poprawiać lokalne szacunki wellness. Możesz korzystać z aplikacji bez podłączania akcesoriów.";
"NSCameraUsageDescription" = "OmniGart używa aparatu tylko gdy skanujesz kod kreskowy żywności, aby wyszukać informacje żywieniowe. Jedzenie możesz dodawać ręcznie bez dostępu do aparatu.";
"NSUserNotificationsUsageDescription" = "OmniGart może wysyłać przypomnienia o treningach, nawodnieniu i porannych sprawdzeniach wellness, które włączysz. Aplikacja działa w pełni przy wyłączonych powiadomieniach.";
