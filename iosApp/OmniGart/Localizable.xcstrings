    "onboarding_sex_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only to choose the male or female body-map figure and sex-specific wellness equations. Not a medical record."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише для вибору чоловічої чи жіночої фігури на карті тіла та статево-специфічних оцінок самопочуття. Це не медичний запис."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko do wyboru męskiej lub żeńskiej sylwetki mapy ciała i równań wellness zależnych od płci. To nie jest dokumentacja medyczna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі для выбару мужчынскай ці жаночай фігуры на карце цела і адзнак самаадчування. Гэта не медыцынскі запіс."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек ер/әйел дене картасы фигурасын және жынысқа тән сауықтыру есептерін таңдау үшін. Медициналық жазба емес."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოიყენება მხოლოდ მამრობითი ან მდედრობითი სხეულის რუკის ფიგურისა და სქესის მიხედვით კეთილდღეობის შეფასებებისთვის. სამედიცინო ჩანაწერი არ არის."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para elegir la figura masculina o femenina del mapa corporal y ecuaciones de bienestar. No es un historial médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour choisir la figure masculine ou féminine de la carte corporelle et des équations de bien-être. Pas un dossier médical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zur Wahl der männlichen oder weiblichen Körperkarten-Figur und geschlechtsspezifischer Wellness-Gleichungen. Keine Krankenakte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen pro volbu mužské nebo ženské postavy na mapě těla a sex-specifických wellness rovnic. Nejde o zdravotní záznam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于选择男/女身体图形象以及与性别相关的健康估算。不是医疗记录。"
          }
        }
      }
    },
