          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паказчыкі здароўя з Apple Health або Health Connect. Толькі чытанне. Толькі дабрабыт."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health немесе Health Connect көрсеткіштері. Тек оқу. Тек сауықтыру көрсетілімі."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯანმრთელობის მეტრიკები Apple Health ან Health Connect-დან. მხოლოდ კითხვა. მხოლოდ კეთილდღეობა."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Métricas de salud de Apple Health o Health Connect. Solo lectura. Solo bienestar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesures de santé depuis Apple Health ou Health Connect. Lecture seule. Affichage bien-être uniquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesundheitswerte aus Apple Health oder Health Connect. Nur Lesen. Nur Wellness-Anzeige."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdravotní metriky z Apple Health nebo Health Connect. Jen čtení. Jen wellness zobrazení."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
