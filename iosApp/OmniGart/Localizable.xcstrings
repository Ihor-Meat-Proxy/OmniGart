    "treadmill_diag_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan nearby devices, list GATT services, subscribe to notify characteristics, and export raw hex as JSON."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйте пристрої поруч, переглядайте служби GATT, підписуйтеся на сповіщення та експортуйте сирий hex у JSON."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanuj pobliskie urządzenia, wyświetl usługi GATT, subskrybuj powiadomienia i eksportuj surowy hex jako JSON."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйце прылады побач, праглядайце службы GATT, падпісвайцеся на апавяшчэнні і экспартуйце сыры hex у JSON."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жақын құрылғыларды сканерлеңіз, GATT қызметтерін қараңыз, хабарландыруларға жазылыңыз және шикі hex-ті JSON ретінде экспорттаңыз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაასკანერეთ ახლომდებარე მოწყობილობები, ნახეთ GATT სერვისები, გამოიწერეთ შეტყობინებები და გაიტანეთ ნედლი hex JSON-ად."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea dispositivos cercanos, lista servicios GATT, suscríbete a notificaciones y exporta hex en bruto como JSON."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez les appareils proches, listez les services GATT, abonnez-vous aux notifications et exportez l’hex brut en JSON."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte in der Nähe scannen, GATT-Dienste auflisten, Notify-Charakteristiken abonnieren und Roh-Hex als JSON exportieren."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenujte okolní zařízení, vypište služby GATT, odebírejte notifikace a exportujte surový hex jako JSON."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描附近设备、列出 GATT 服务、订阅通知特征，并将原始十六进制导出为 JSON。"
          }
        }
      }
    },
