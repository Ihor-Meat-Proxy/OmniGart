  "technique": [
    "Stabilise the rings in support, descend under control, press to support with rings turned out slightly at the top."
  ],
  "setup": [
    "Ring height appropriate; hollow body; master parallel-bar dips first."
  ],
  "breathing": "Exhale to press.",
  "commonMistakes": [
    "Losing ring stability",
    "Excess depth under fatigue"
  ],
  "safety": [
    "Rings increase stability demand; kinematic work suggests ring dips may use less peak shoulder extension than bar dips for some athletes — still respect pain-free depth (McKenzie et al. 2022)."
  ],
  "contraindications": [
    "Shoulder instability"
