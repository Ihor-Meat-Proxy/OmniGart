    "insights_fitness_caption": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "42-day fitness and 7-day fatigue with a confidence band and rest projection."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "42-денна форма і 7-денна втома з діапазоном довіри та проєкцією відпочинку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "42-dniowa forma i 7-dniowe zmęczenie z pasmem pewności i projekcją odpoczynku."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "42-дзённая форма і 7-дзённая стомленасць з дыяпазонам даверу і праекцыяй адпачынку."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "42 күндік форма және 7 күндік шаршау, сенім жолағы және демалыс болжамымен."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "42-დღიანი ფორმა და 7-დღიანი დაღლილობა ნდობის ზოლითა და დასვენების პროექციით."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma a 42 días y fatiga a 7 días con banda de confianza y proyección de descanso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forme sur 42 jours et fatigue sur 7 jours avec bande de confiance et projection de repos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "42-Tage-Fitness und 7-Tage-Ermüdung mit Vertrauensband und Ruhe-Projektion."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "42denní forma a 7denní únava s pásmem jistoty a projekcí odpočinku."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "42 天体能与 7 天疲劳，含置信带与休息推演。"
          }
        }
      }
    },
