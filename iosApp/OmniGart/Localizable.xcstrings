    "onboarding_birth_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Age is used for wellness estimates such as energy use and heart-rate zones."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вік потрібен для оцінок самопочуття: енергоспоживання та зон пульсу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiek służy do szacunków wellness, np. zużycia energii i stref tętna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Узрост патрэбны для ацэнак самаадчування: энергіі і зон пульсу."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жас энергия шығыны мен жүрек соғу аймақтары сияқты сауықтыру бағалауларына керек."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ასაკი გამოიყენება კეთილდღეობის შეფასებებისთვის, მაგ. ენერგია და გულისცემის ზონები."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edad se usa en estimaciones de bienestar como energía y zonas de frecuencia cardíaca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’âge sert aux estimations de bien-être (énergie, zones de fréquence cardiaque)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Alter fließt in Wellness-Schätzungen wie Energieverbrauch und Herzfrequenzzonen ein."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Věk se používá pro wellness odhady, např. energetický výdej a tepové zóny."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
