    "insights_intro": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Training trends from your on-device workouts. Wellness estimates only — not medical advice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тенденції тренувань із локальних занять. Лише оцінки добробуту — не медична порада."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trendy treningowe z lokalnych treningów. Tylko szacunki wellness — nie porada medyczna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэндэнцыі трэніровак з лакальных заняткаў. Толькі ацэнкі дабрабыту — не медыцынская парада."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құрылғыдағы жаттығулардан трендтер. Тек сауықтыру бағалаулары — медициналық кеңес емес."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ტენდენციები თქვენი ადგილობრივი ვარჯიშებიდან. მხოლოდ კეთილდღეობის შეფასებები — არა სამედიცინო რჩევა."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendencias de entrenamiento desde tus entrenos en el dispositivo. Solo estimaciones de bienestar — no consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendances d’entraînement depuis vos séances sur l’appareil. Estimations bien-être uniquement — pas un avis médical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingstrends aus Ihren Geräte-Workouts. Nur Wellness-Schätzungen — keine medizinische Beratung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tréninkové trendy z lokálních tréninků. Pouze wellness odhady — ne lékařská rada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自本机训练的趋势。仅为健康估算，不是医疗建议。"
          }
        }
      }
    },
