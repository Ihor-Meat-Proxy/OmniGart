          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV, тыныш жүрек соғысы немесе ұйқы жеңілірек күнді ұсынады."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV, მოსვენების პულსი ან ძილი უფრო მსუბუქ დღეს გვთავაზობს."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV, FC en reposo o sueño sugieren un día más fácil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV, FC de repos ou sommeil suggèrent une journée plus facile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV, Ruheherzfrequenz oder Schlaf legen einen leichteren Tag nahe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV, klidová tepová frekvence nebo spánek naznačují lehčí den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
