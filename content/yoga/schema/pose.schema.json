{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnigart.dev/schemas/yoga-pose.schema.json",
  "title": "OmniGartYogaPose",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "englishNameKeys",
    "sanskritNameKeys",
    "family",
    "level",
    "primaryMuscles",
    "secondaryMuscles",
    "equipment",
    "technique",
    "cues",
    "breathing",
    "safetyNotes",
    "contraindicationNotes",
    "evidenceEntryIds",
    "holdSecondsDefault",
    "bundled"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80
    },
    "englishNameKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enGB",
        "uk"
      ],
      "properties": {
        "enGB": {
          "type": "string",
          "pattern": "^yoga\\.pose\\.[a-z0-9_]+\\.english$"
        },
        "uk": {
          "type": "string",
          "pattern": "^yoga\\.pose\\.[a-z0-9_]+\\.english$"
        }
      }
    },
    "sanskritNameKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enGB",
        "uk"
      ],
      "properties": {
        "enGB": {
          "type": "string",
          "pattern": "^yoga\\.pose\\.[a-z0-9_]+\\.sanskrit$"
        },
        "uk": {
          "type": "string",
          "pattern": "^yoga\\.pose\\.[a-z0-9_]+\\.sanskrit$"
        }
      }
    },
    "family": {
      "type": "string",
      "enum": [
        "standing",
        "seated",
        "supine",
        "prone",
        "inversion",
        "balance",
        "twist",
        "forward_fold",
        "backbend",
        "hip_opener",
        "restorative",
        "transition"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "primaryMuscles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/muscleTaxonomyId"
      }
    },
    "secondaryMuscles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/muscleTaxonomyId"
      }
    },
    "equipment": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "yoga_mat",
          "yoga_block",
          "yoga_strap",
          "bolster",
          "blanket",
          "bodyweight",
          "none"
        ]
      }
    },
    "technique": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "breathing": {
      "type": "string",
      "minLength": 8
    },
    "safetyNotes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "contraindicationNotes": {
      "type": "array",
      "description": "General safety framing — not medical diagnosis. Soft guidance for common situations.",
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "evidenceEntryIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
      }
    },
    "holdSecondsDefault": {
      "type": "integer",
      "minimum": 5,
      "maximum": 600
    },
    "unilateral": {
      "type": "boolean",
      "default": false
    },
    "bundled": {
      "type": "boolean",
      "const": true
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "muscleTaxonomyId": {
      "type": "string",
      "enum": [
        "quadriceps",
        "hamstrings",
        "gluteus_maximus",
        "gluteus_medius",
        "calves",
        "hip_flexors",
        "adductors",
        "pectoralis_major",
        "latissimus_dorsi",
        "trapezius",
        "rhomboids",
        "rear_deltoid",
        "front_deltoid",
        "lateral_deltoid",
        "biceps",
        "triceps",
        "forearms",
        "rectus_abdominis",
        "obliques",
        "transverse_abdominis",
        "erector_spinae",
        "full_body",
        "rotator_cuff",
        "serratus_anterior",
        "tibialis_anterior",
        "neck"
      ]
    }
  }
}
