    "food_gaps_hint": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions use reference intakes and your log. Wellness coaching only — not medical advice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропозиції базуються на референсному споживанні та вашому журналі. Лише wellness — не медична порада."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugestie opierają się na spożyciu referencyjnym i Twoim dzienniku. Tylko wellness — nie porada medyczna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прапановы заснаваны на рэферэнсным ужыванні і вашым журнале. Толькі wellness — не медыцынская парада."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ұсыныстар анықтамалық тұтыну мен журналыңызға негізделген. Тек сауықтыру — медициналық кеңес емес."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რჩევები ეყრდნობა საცნობარო მიღებას და თქვენს ჟურნალს. მხოლოდ კეთილდღეობა — არა სამედიცინო რჩევა."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias usan ingestas de referencia y tu registro. Solo bienestar — no consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions s’appuient sur les apports de référence et votre journal. Bien-être seulement — pas un avis médical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge nutzen Referenzzufuhren und Ihr Protokoll. Nur Wellness — keine medizinische Beratung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Návrhy vycházejí z referenčních příjmů a vašeho deníku. Jen wellness — ne lékařská rada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议基于参考摄入量与您的记录。仅供健康参考，不是医疗建议。"
          }
        }
      }
