    "perm_explainer_camera_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used only to scan food barcodes. You can log food manually if you deny access."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера використовується лише для сканування штрихкодів продуктів. Їжу можна додавати вручну, якщо відмовите в доступі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparat służy wyłącznie do skanowania kodów kreskowych żywności. Możesz logować jedzenie ręcznie, jeśli odmówisz dostępu."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера выкарыстоўваецца толькі для сканавання штыхкодаў прадуктаў. Ежу можна дадаваць уручную, калі адмовіце ў доступе."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера тек тағам штрихкодтарын сканерлеу үшін қолданылады. Қолжетімділікті қабылдамасаңыз, тағамды қолмен жаза аласыз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კამერა გამოიყენება მხოლოდ საკვების შტრიხკოდების სკანირებისთვის. წვდომის უარყოფის შემთხვევაში საკვები შეგიძლიათ ხელით ჩაიწეროთ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara solo se usa para escanear códigos de barras de alimentos. Puedes registrar comida manualmente si deniegas el acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra sert uniquement à scanner les codes-barres alimentaires. Vous pouvez enregistrer la nourriture manuellement si vous refusez l’accès."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera dient nur zum Scannen von Lebensmittel-Barcodes. Sie können Essen manuell erfassen, wenn Sie den Zugriff verweigern."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoaparát se používá pouze ke skenování čárových kódů potravin. Jídlo můžete zaznamenat ručně, pokud přístup odepřete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机仅用于扫描食品条码。若拒绝访问，仍可手动记录饮食。"
          }
        }
      }
    },
