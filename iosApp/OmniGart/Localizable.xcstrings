    "nutrition_measurements_intro": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored on this device. Waist-to-height is shown for awareness and is not used in the energy formula."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається на цьому пристрої. Співвідношення талія/зріст показано для орієнтиру і не входить у формулу енергії."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowywane na tym urządzeniu. Stosunek talia/wzrost jest tylko informacyjny i nie wchodzi do wzoru energii."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Захоўваецца на гэтай прыладзе. Суадносіны талія/рост паказаны для арыенціру і не ўваходзяць у формулу энергіі."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы құрылғыда сақталады. Бел/бой қатынасы ақпарат үшін көрсетіледі және энергия формуласына кірмейді."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ინახება ამ მოწყობილობაზე. წელი/სიმაღლე ნაჩვენებია ინფორმაციისთვის და ენერგიის ფორმულაში არ შედის."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en este dispositivo. La relación cintura/altura es informativa y no entra en la fórmula de energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé sur cet appareil. Le rapport taille/hauteur est indicatif et n’entre pas dans la formule d’énergie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf diesem Gerät gespeichert. Taille-zu-Größe dient der Orientierung und fließt nicht in die Energieformel ein."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo v tomto zařízení. Poměr pas/výška je informativní a nevstupuje do vzorce energie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在本设备。腰高比仅供参考，不参与能量公式。"
          }
        }
      }
    },
