          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Бег на дарожцы захаваны лакальна і ў Apple Health / Health Connect пры дазволе."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүгіру жолы жергілікті және рұқсат болса Apple Health / Health Connect-ке сақталды."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სარბენი ბილიკი შენახულია ადგილობრივად და Apple Health / Health Connect-ში ნებართვისას."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrera en cinta guardada en el dispositivo y en Apple Health / Health Connect si se permite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Course tapis enregistrée localement et dans Apple Health / Health Connect si autorisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufband-Lauf lokal und in Apple Health / Health Connect gespeichert (falls erlaubt)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běh na pásu uložen lokálně a do Apple Health / Health Connect, pokud je povoleno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跑步机跑步已保存在本地；若已授权也会写入 Apple Health / Health Connect。"
          }
        }
      }
