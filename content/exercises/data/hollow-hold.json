  "technique": [
    "Lie supine; press the low back into the floor; lift shoulders and legs into a shallow hollow while keeping ribs down.",
    "Hold without letting the lumbar spine arch away from the floor."
  ],
  "setup": [
    "Arms by ears or by sides; legs long and together."
  ],
  "breathing": "Steady breathing while bracing; do not hold the breath.",
  "commonMistakes": [
    "Arching the low back",
    "Only lifting the head"
  ],
  "safety": [
    "Bend the knees (tuck hollow) if the low back leaves the floor."
  ],
