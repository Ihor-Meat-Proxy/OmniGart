  "technique": [
    "Pull to the top, then shift the chest laterally along the bar toward one hand while staying high, then to the other, then lower."
  ],
  "setup": [
    "Requires strong isometric top position; clear bar length."
  ],
  "breathing": "Steady breathing at the top; exhale as you shift.",
  "commonMistakes": [
    "Dropping the hips while shifting",
    "Losing chin height"
  ],
  "safety": [
    "Advanced — fatigue raises shoulder risk; low volume."
  ],
