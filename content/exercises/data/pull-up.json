  "trackingType": "bodyweight_reps",
  "technique": [
    "Hang from a bar with a pronated (overhand) grip about shoulder-width or slightly wider.",
    "Depress and retract the scapulae, then pull elbows down and back until the chin clears the bar.",
    "Lower under control to a full hang without dumping into the shoulder capsule."
  ],
  "setup": [
    "Stable pull-up bar; wrists stacked; light brace; legs quiet or crossed."
  ],
  "breathing": "Exhale on the concentric pull; inhale on the descent.",
  "commonMistakes": [
    "Kipping when the goal is strict strength",
    "Starting with shrugged scapulae",
    "Partial range without intent"
  ],
  "safety": [
    "Stop with anterior shoulder pain in the hang",
    "Build volume with assistance before max efforts"
  ],
  "contraindications": [
    "Acute shoulder injury",
    "Uncontrolled cuff tear symptoms"
  ],
