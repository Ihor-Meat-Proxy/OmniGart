{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnigart.dev/schemas/workout-template.schema.json",
  "title": "OmniGartWorkoutTemplate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nameKeys",
    "disciplines",
    "level",
    "goal",
    "daysPerWeek",
    "sessionMinutes",
    "equipmentPreset",
    "equipmentRequired",
    "rationale",
    "evidenceRefs",
    "sessions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nameKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enGB", "uk"],
      "properties": {
        "enGB": { "type": "string" },
        "uk": { "type": "string" }
      }
    },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["strength", "yoga", "pilates", "swimming", "running"]
      },
      "uniqueItems": true
    },
    "level": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "goal": {
      "type": "string",
      "enum": [
        "general_fitness",
        "hypertrophy",
        "strength",
        "endurance",
        "mobility",
        "fat_loss_support",
        "technique",
        "race_prep"
      ]
    },
    "daysPerWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
    "sessionMinutes": { "type": "integer", "minimum": 10, "maximum": 180 },
    "equipmentPreset": {
      "type": "string",
      "enum": ["home_gym", "commercial_gym", "travel", "bodyweight", "pool", "custom"]
    },
    "equipmentRequired": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "rationale": { "type": "string", "minLength": 40 },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "description": "Pointers into content/evidence catalog (stable evidenceId).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "supports"],
        "properties": {
          "evidenceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
            "minLength": 4,
            "maxLength": 80
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nameKeys", "blocks"],
        "properties": {
          "id": { "type": "string" },
          "nameKeys": {
            "type": "object",
            "required": ["enGB", "uk"],
            "properties": {
              "enGB": { "type": "string" },
              "uk": { "type": "string" }
            }
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "items"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["warmup", "main", "accessory", "cooldown", "skill"]
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["exerciseId"],
                    "properties": {
                      "exerciseId": { "type": "string" },
                      "sets": { "type": "integer", "minimum": 1 },
                      "reps": { "type": "string" },
                      "rir": { "type": "string" },
                      "restSeconds": { "type": "integer", "minimum": 0 },
                      "durationSeconds": { "type": "integer", "minimum": 1 },
                      "distanceMeters": { "type": "integer", "minimum": 1 },
                      "notes": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
