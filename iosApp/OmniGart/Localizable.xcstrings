    "nutrition_target_disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated daily energy — a wellness coaching aid, not medical or dietary advice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орієнтовна денна енергія — тренерська підказка, не медична чи дієтологічна порада."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacowana energia dzienna — wskazówka wellness, nie porada medyczna ani dietetyczna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Арыентоўная дзённая энергія — трэнерская падказка, не медыцынская ці дыеталагічная парада."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Болжалды күнделікті энергия — сауықтыру кеңесі, медициналық немесе диеталық кеңес емес."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სავარაუდო დღიური ენერგია — კეთილდღეობის რჩევა, არა სამედიცინო ან დიეტური კონსულტაცია."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Energía diaria estimada: ayuda de bienestar, no consejo médico ni dietético."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Énergie quotidienne estimée — aide bien-être, pas un avis médical ou diététique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschätzte Tagesenergie — Wellness-Hilfe, keine medizinische oder ernährungsmedizinische Beratung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhadovaná denní energie — wellness pomůcka, ne lékařská ani dietní rada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "估计每日能量——健康教练参考，不是医疗或饮食建议。"
          }
        }
      }
    },
