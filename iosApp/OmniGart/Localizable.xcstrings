    "onboarding_welcome_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A few questions so we can personalise wellness estimates on your device. You can change these later in Profile."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кілька запитань, щоб налаштувати оцінки самопочуття на вашому пристрої. Пізніше можна змінити в Профілі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka pytań, by spersonalizować szacunki wellness na urządzeniu. Zmieńisz je później w Profilu."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Некалькі пытанняў, каб наладзіць ацэнкі самаадчування на вашай прыладзе. Пазней можна змяніць у Профілі."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құрылғыдағы сауықтыру бағалауларын жекелендіру үшін бірнеше сұрақ. Кейін Профильден өзгерте аласыз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რამდენიმე კითხვა, რომ მოწყობილობაზე კეთილდღეობის შეფასებები მოვარგოთ. მოგვიანებით პროფილში შეცვლით."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas preguntas para personalizar las estimaciones de bienestar en tu dispositivo. Puedes cambiarlas después en Perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques questions pour personnaliser les estimations de bien-être sur votre appareil. Modifiables plus tard dans Profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Fragen, um Wellness-Schätzungen auf Ihrem Gerät anzupassen. Später unter Profil änderbar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pár otázek pro personalizaci wellness odhadů na zařízení. Později změníte v Profilu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几个问题，用于在您的设备上个性化健康估算。之后可在“个人资料”中修改。"
          }
        }
      }
    },
