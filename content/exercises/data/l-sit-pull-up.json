  "technique": [
    "From a hang, raise straight legs to an L (hips ~90°) and hold that position while performing pull-ups.",
    "Keep the lumbar spine from excessively rounding or swinging."
  ],
  "setup": [
    "Needs solid hanging leg-raise control before loading pull-ups."
  ],
  "breathing": "Exhale on the pull; do not breath-hold the entire L.",
  "commonMistakes": [
    "Dropping the legs mid-set",
    "Kipping out of the L"
  ],
  "safety": [
    "Stop if hip-flexor cramping forces loss of shoulder position."
  ],
  "contraindications": [
    "Acute lumbar disc flare with hip flexion"
  ],
