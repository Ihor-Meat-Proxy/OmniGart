/* pl — Watch HealthKit, Bluetooth, camera, notifications */
"NSHealthShareUsageDescription" = "OmniGart na Apple Watch odczytuje tętno, HRV, treningi oraz aktywną i spoczynkową energię z Apple Health, aby pokazywać szacunki wellness na zegarku. Jeśli próbka zostanie później usunięta z Apple Health, OmniGart zachowuje kopię na urządzeniu. Dane zdrowotne nie są wykorzystywane do reklam ani udostępniane stronom trzecim.";
"NSHealthUpdateUsageDescription" = "OmniGart na Apple Watch zapisuje treningi siłowe, jogę, pilates i strefę 2 — z czasem trwania, aktywną i spoczynkową energią, tętnem oraz segmentami — w Apple Health, aby pojawiały się w Fitness. Zapis jest tylko dołączający: OmniGart nigdy nie usuwa ani nie nadpisuje danych Apple Health, także własnych; późniejsze edycje zostają w OmniGart. Dane nie służą reklamom i nie są sprzedawane.";
"NSBluetoothAlwaysUsageDescription" = "OmniGart może używać Bluetooth podczas indoorowego biegu na bieżni, aby odczytać prędkość, nachylenie i dystans ze zgodnej bieżni oraz dla akcesoriów do pomiaru tętna, które wybierzesz. Aplikacja na zegarku działa bez akcesorium.";
"NSCameraUsageDescription" = "Aparat nie jest wymagany na Apple Watch dla OmniGart; ten opis jest wspólny z uprawnieniami aplikacji iPhone.";
"NSUserNotificationsUsageDescription" = "OmniGart może przypominać o treningach i sprawdzeniach wellness, które włączysz. Aplikacja działa przy wyłączonych powiadomieniach.";
