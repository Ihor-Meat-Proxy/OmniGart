    <string name="shell_intro">Wellness estimates from your shared OmniGart profile</string>

    <string name="wellness_disclaimer">OmniGart provides wellness estimates only. Readiness, stress, HRV, Baevsky index, body-fat estimates, hydration targets, and training plans are not medical advice. Consult a qualified professional for health concerns.</string>
    <string name="info_sheet_not_medical_advice">Not medical advice. Consult a professional.</string>
    <string name="health_warning_chest_pain">Stop and seek emergency help if you feel chest pain, severe dizziness, or unusual shortness of breath during activity.</string>
    <string name="onboarding_wellness_title">Wellness, not medical care</string>
    <string name="info_sheet_title">About this estimate</string>
    <string name="info_sheet_body">Figures such as readiness, stress, HRV, Baevsky index, body fat, and hydration are wellness estimates based on your inputs and device samples. Plans are coaching suggestions, not prescriptions.</string>

    <string name="perm_explainer_health_title">Apple Health / Health Connect</string>
    <string name="perm_explainer_health_body">OmniGart can read and write wellness samples (heart rate, HRV, sleep, workouts, body mass, hydration) to improve on-device estimates. Data is not used for ads or sent to unrelated third parties. You can continue without granting access.</string>
    <string name="perm_explainer_bluetooth_title">Bluetooth accessories</string>
    <string name="perm_explainer_bluetooth_body">Connect a heart-rate or similar fitness accessory for live samples. OmniGart works fully without Bluetooth.</string>
    <string name="perm_explainer_camera_title">Camera for barcodes</string>
    <string name="perm_explainer_camera_body">The camera is used only to scan food barcodes. You can log food manually if you deny access.</string>
    <string name="perm_explainer_notifications_title">Reminders</string>
    <string name="perm_explainer_notifications_body">Optional reminders for workouts, hydration, and morning wellness check-ins. The app stays usable with notifications off.</string>
    <string name="perm_continue">Continue</string>
    <string name="perm_not_now">Not now</string>

    <string name="hc_rationale_title">Health Connect data use</string>
    <string name="hc_rationale_body">OmniGart requests Health Connect access to read and write fitness and wellness data you choose — such as heart rate, HRV, sleep, workouts, body mass, and hydration — so readiness and training estimates stay accurate on your device.\n\nWe do not sell health data, use it for advertising, or share it with third parties for marketing. You can deny access and keep using OmniGart with manual entry.</string>
    <string name="hc_rationale_privacy_policy">Privacy policy</string>

