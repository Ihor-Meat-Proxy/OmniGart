          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowość jest dziś niższa — zamień ciężką sesję na łatwy Zone 2."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гатоўнасць сёння мякчэйшая — заменіце цяжкую сесію на лёгкі Zone 2."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін дайындық жұмсағырақ — ауыр сессияны жеңіл Zone 2-ге ауыстырыңыз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღეს მზადყოფნა რბილდება — მძიმე სესია შეცვალეთ მსუბუქი Zone 2-ით."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposición es más suave hoy — cambia una sesión dura por Zone 2 fácil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposition est plus douce aujourd’hui — remplacez une séance dure par une Zone 2 facile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bereitschaft ist heute weicher — tauschen Sie eine harte Einheit gegen easy Zone 2."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připravenost je dnes měkčí — vyměňte těžkou jednotku za lehký Zone 2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日准备度偏弱——可将硬课换成轻松二区。"
          }
