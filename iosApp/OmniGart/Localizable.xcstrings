    "food_reference_intake_note": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Micronutrient amounts use reference intakes (EFSA/IOM-style), not medical targets."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікронутрієнти порівнюються з референсним споживанням (EFSA/IOM), не з медичними цілями."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikronutrienty porównujemy do spożycia referencyjnego (styl EFSA/IOM), nie do celów medycznych."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікранутрыенты параўноўваюцца з рэферэнсным спажываннем (стыль EFSA/IOM), не з медычнымі мэтамі."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Микронутриенттер анықтамалық қабылдаумен (EFSA/IOM) салыстырылады, медициналық мақсат емес."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიკრონუტრიენტები საცნობარო მიღებასთან (EFSA/IOM) იდარება, არა სამედიცინო მიზნებთან."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los micronutrientes se comparan con ingestas de referencia (estilo EFSA/IOM), no con objetivos médicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les micronutriments sont comparés aux apports de référence (style EFSA/IOM), pas à des objectifs médicaux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikronährstoffe werden mit Referenzzufuhren (EFSA/IOM-Stil) verglichen, nicht mit medizinischen Zielen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikronutrienty srovnáváme s referenčním příjmem (styl EFSA/IOM), ne s lékařskými cíli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微量营养素对照参考摄入量（EFSA/IOM 风格），并非医疗目标。"
          }
        }
      }
    },
