            "value": "Узважванне дапамагае персаналізаваць энергетычную мэту."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өлшеу энергия мақсатын жекелендіруге көмектеседі."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აწონვა ენერგიის მიზნის პერსონალიზებას ეხმარება."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pesaje ayuda a personalizar tu objetivo energético."
          }
        },
        "fr": {
          "stringUnit": {
