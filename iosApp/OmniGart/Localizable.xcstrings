    "workout_mindful_body_intro": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer a live watch session for heart rate and energy. On iPhone alone, OmniGart saves a MET wellness estimate labelled as such."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Краще жива сесія на годиннику для пульсу й енергії. Лише на iPhone OmniGart зберігає оцінку MET із відповідною позначкою."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferuj żywą sesję na zegarku dla tętna i energii. Na samym iPhonie OmniGart zapisuje szacunek MET z etykietą."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Лепш жывая сесія на гадзінніку для пульсу й энергіі. Толькі на iPhone OmniGart захоўвае ацэнку MET з пазнакай."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүрек соғысы мен энергия үшін сағаттағы тірі сеансты таңдаңыз. Тек iPhone-да OmniGart MET бағалауын белгілеп сақтайды."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გულისცემისა და ენერგიისთვის უპირატესობა მიანიჭეთ საათის ცოცხალ სესიას. მხოლოდ iPhone-ზე OmniGart ინახავს MET შეფასებას შესაბამისი ნიშნით."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefiere una sesión en vivo en el reloj para frecuencia y energía. Solo en iPhone, OmniGart guarda una estimación MET etiquetada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préférez une séance live sur la montre pour le pouls et l’énergie. Sur iPhone seul, OmniGart enregistre une estimation MET étiquetée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevorzugen Sie eine Live-Session auf der Watch für Puls und Energie. Nur auf dem iPhone speichert OmniGart eine gekennzeichnete MET-Schätzung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferujte živou relaci na hodinkách pro tep a energii. Jen na iPhonu OmniGart uloží označený odhad MET."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议用手表实时会话采集心率与能量。仅在 iPhone 上时，OmniGart 会保存带标注的 MET 健康估算。"
          }
        }
      }
    },
