/* ka — Watch HealthKit, Bluetooth, camera, notifications */
"NSHealthShareUsageDescription" = "OmniGart Apple Watch-ზე კითხულობს გულისცემას, HRV-ს, ვარჯიშებს და აქტიურ/საბაზისო ენერგიას Apple Health-იდან, რათა საათზე კეთილდღეობის შეფასებები აჩვენოს. თუ ნიმუში მოგვიანებით ამოიშლება, OmniGart ინახავს ასლს მოწყობილობაზე. ჯანმრთელობის მონაცემები არ გამოიყენება რეკლამისთვის და არ უზიარდება მესამე მხარეებს.";
"NSHealthUpdateUsageDescription" = "OmniGart Apple Watch-ზე ინახავს ძალის, იოგის, პილატესის და ზონა 2-ის ვარჯიშებს — ხანგრძლივობით, აქტიური და საბაზისო ენერგიით, გულისცემით და სეგმენტებით — Apple Health-ში, რათა გამოჩნდნენ Fitness-ში. ჩაწერა მხოლოდ ამატებს: OmniGart არასოდეს შლის ან გადაწერს Apple Health-ის მონაცემებს, მათ შორის საკუთარს; შემდგომი ცვლილებები რჩება OmniGart-ში. მონაცემები არ გამოიყენება რეკლამისთვის და არ იყიდება.";
"NSBluetoothAlwaysUsageDescription" = "OmniGart შეიძლება გამოიყენოს Bluetooth შიდა სარბენ ბილიკზე სირბილისას, რათა წაიკითხოს სიჩქარე, დახრილობა და მანძილი თავსებადი ბილიკიდან, ასევე თქვენ მიერ არჩეული გულისცემის აქსესუარებისთვის. საათის აპი აქსესუარის გარეშეც მუშაობს.";
"NSCameraUsageDescription" = "Apple Watch-ზე OmniGart-ისთვის კამერა არ არის საჭირო; ეს აღწერა გაზიარებულია iPhone აპის ნებართვებთან.";
"NSUserNotificationsUsageDescription" = "OmniGart შეუძლია შეგახსენოთ ვარჯიშები და კეთილდღეობის შემოწმებები, რომლებსაც ჩართავთ. აპი მუშაობს გამორთული შეტყობინებებითაც.";
