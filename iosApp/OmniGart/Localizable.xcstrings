    "health_restore_removed_banner": {
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed from the health platform. Your OmniGart copy is still here — you can restore it."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибрано з платформи здоров’я. Копія в OmniGart лишається — можна відновити."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto z platformy zdrowotnej. Kopia w OmniGart nadal jest — możesz ją przywrócić."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прыбрана з платформы здароўя. Копія ў OmniGart застаецца — можна аднавіць."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сауықтыру платформасынан өшірілді. OmniGart көшірмесі бар — қалпына келтіруге болады."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯანმრთელობის პლატფორმიდან წაიშალა. OmniGart ასლი რჩება — შეგიძლიათ აღადგინოთ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminado de la plataforma de salud. La copia en OmniGart sigue aquí — puedes restaurarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retiré de la plateforme santé. Votre copie OmniGart est toujours là — vous pouvez la restaurer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Gesundheitsplattform entfernt. Ihre OmniGart-Kopie ist noch da — Sie können sie wiederherstellen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraněno ze zdravotní platformy. Kopie v OmniGart zůstává — můžete ji obnovit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从健康平台移除。OmniGart 本地副本仍在——可以恢复。"
          }
        }
      }
    },
