  "technique": [
    "Hands on a bench behind you, feet on the floor (or elevated for harder variants); bend elbows to lower, then extend.",
    "Keep hips close to the bench; use a modest ROM if shoulders complain."
  ],
  "setup": [
    "Stable bench; shoulders away from ears."
  ],
  "breathing": "Exhale to extend.",
  "commonMistakes": [
    "Going too deep into shoulder extension",
    "Flaring elbows without control"
  ],
  "safety": [
    "Bench dips often use large shoulder extension — prefer shallow ROM or parallel-bar progressions if shoulders are irritable (McKenzie et al. 2020/2022)."
  ],
  "contraindications": [
    "Anterior shoulder pain in extension"
  ],
