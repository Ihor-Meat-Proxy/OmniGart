  "technique": [
    "From a pike (hips high, hands and feet on floor), bend the elbows to lower the head toward the floor between the hands.",
    "Press back to the pike without flaring the ribs."
  ],
  "setup": [
    "Hands roughly shoulder-width; hips stacked above shoulders as much as mobility allows."
  ],
  "breathing": "Inhale down; exhale as you press up.",
  "commonMistakes": [
    "Collapsing into a flat push-up",
    "Flaring elbows aggressively"
  ],
  "safety": [
    "Elevate hands to regress; stop with sharp shoulder pain."
