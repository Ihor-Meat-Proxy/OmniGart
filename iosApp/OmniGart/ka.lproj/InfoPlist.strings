/* ka — HealthKit, Bluetooth, camera, notifications purpose strings */
"NSHealthShareUsageDescription" = "OmniGart კითხულობს გულისცემას, HRV-ს, ძილს, ვარჯიშებს, აქტიურ და საბაზისო ენერგიას, გულისცემის აღდგენას, ვარჯიშის ძალისხმევას, ყურადღებიანობის წუთებს (როცა ჩართავთ), სხეულის მასას და კეთილდღეობის ნიმუშებს Apple Health-იდან, რათა აჩვენოს მზადყოფნა, აღდგენა და ვარჯიშის შეფასებები მოწყობილობაზე. თუ ნიმუში მოგვიანებით ამოიშლება Apple Health-იდან, OmniGart ინახავს ასლს მოწყობილობაზე. ჯანმრთელობის მონაცემები რჩება თქვენს მოწყობილობებზე და არ გამოიყენება რეკლამისთვის და არ იყიდება მესამე მხარეებზე.";
"NSHealthUpdateUsageDescription" = "OmniGart წერს ძალის, იოგის, პილატესის, ზონა 2-ის და შიდა სარბენი ბილიკის ვარჯიშებს — ხანგრძლივობით, აქტიური და საბაზისო ენერგიით, გულისცემით, დაკავშირებული ბილიკის მანძილით (როცა ხელმისაწვდომია), სეგმენტებით და აღდგენის ან ძალისხმევის ქულებით — ასევე სურვილისამებრ ყურადღებიანობის წუთებს და არჩეულ კეთილდღეობის მეტრიკებს Apple Health-ში, რათა გამოჩნდნენ Fitness-ში. ჩაწერა მხოლოდ ამატებს: OmniGart არასოდეს შლის ან გადაწერს Apple Health-ის მონაცემებს, მათ შორის საკუთარს; შემდგომი ცვლილებები რჩება OmniGart-ში. არაფერი იგზავნება რეკლამის განმთავსებლებთან ან უცხო მესამე მხარეებთან.";
"NSBluetoothAlwaysUsageDescription" = "OmniGart იყენებს Bluetooth-ს თქვენ მიერ არჩეულ სარბენ ბილიკებთან და გულისცემის აქსესუარებთან დასაკავშირებლად, რათა ცოცხალი სიჩქარე, დახრილობა და მანძილი გამოჩნდეს «სარბენ ბილიკზე სირბილში» და გააუმჯობესოს კეთილდღეობის შეფასებები მოწყობილობაზე. აპით სარგებლობა აქსესუარის გარეშეც შეიძლება.";
"NSCameraUsageDescription" = "OmniGart კამერას იყენებს მხოლოდ მაშინ, როცა საკვების შტრიხკოდს ასკანერებთ კვებითი ინფორმაციის მოსაძებნად. საკვების ხელით დამატება კამერის გარეშეც შეიძლება.";
"NSUserNotificationsUsageDescription" = "OmniGart შეუძლია გამოგიგზავნოთ შეხსენებები ვარჯიშებზე, ჰიდრატაციაზე და დილის კეთილდღეობის შემოწმებებზე, რომლებსაც ჩართავთ. აპი სრულად მუშაობს გამორთული შეტყობინებებითაც.";
