    "insights_empty_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Log or import workouts to see fitness, load and trends here."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть або імпортуйте тренування, щоб бачити форму, навантаження і тренди."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz lub zaimportuj treningi, aby zobaczyć formę, obciążenie i trendy."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запішыце або імпартуйце трэніроўкі, каб бачыць форму, нагрузку і тэндэнцыі."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма, жүктеме және трендтерді көру үшін жаттығуларды жазыңыз немесе импорттаңыз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩაიწერეთ ან შემოიტანეთ ვარჯიშები ფორმის, დატვირთვისა და ტენდენციების სანახავად."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra o importa entrenos para ver forma, carga y tendencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ou importez des séances pour voir forme, charge et tendances."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Workouts erfassen oder importieren, um Fitness, Load und Trends zu sehen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenejte nebo importujte tréninky pro formu, zátěž a trendy."
          }
        },
        "zh-Hans": {
