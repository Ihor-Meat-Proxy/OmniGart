    "shell_intro": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellness estimates from your shared OmniGart profile"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінки самопочуття з вашого спільного профілю OmniGart"
          }
        }
      }
    },
    "wellness_disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart provides wellness estimates only. Readiness, stress, HRV, Baevsky index, body-fat estimates, hydration targets, and training plans are not medical advice. Consult a qualified professional for health concerns."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart надає лише оцінки самопочуття. Готовність, стрес, ВСР, індекс Баєвського, оцінка жиру в тілі, цілі гідратації та плани тренувань не є медичною консультацією. Звертайтеся до кваліфікованого фахівця щодо питань здоров’я."
          }
        }
      }
    },
    "info_sheet_not_medical_advice": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not medical advice. Consult a professional."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не медична консультація. Зверніться до фахівця."
          }
        }
      }
    },
    "health_warning_chest_pain": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop and seek emergency help if you feel chest pain, severe dizziness, or unusual shortness of breath during activity."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиніться і зверніться по екстрену допомогу, якщо під час активності відчуваєте біль у грудях, сильне запаморочення або незвичну задишку."
          }
        }
      }
    },
    "onboarding_wellness_title": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellness, not medical care"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Самопочуття, не медицина"
          }
        }
      }
    },
    "info_sheet_title": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "About this estimate"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Про цю оцінку"
          }
        }
      }
    },
    "info_sheet_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Figures such as readiness, stress, HRV, Baevsky index, body fat, and hydration are wellness estimates based on your inputs and device samples. Plans are coaching suggestions, not prescriptions."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показники на кшталт готовності, стресу, ВСР, індексу Баєвського, жиру в тілі та гідратації — це оцінки самопочуття на основі ваших даних і зразків із пристрою. Плани — тренерські пропозиції, а не приписи лікаря."
          }
        }
      }
    },
    "perm_explainer_health_title": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health"
          }
        }
      }
    },
    "perm_explainer_health_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart can read and write wellness samples (heart rate, HRV, sleep, workouts, body mass, hydration) to improve on-device estimates. Data is not used for ads or sent to unrelated third parties. You can continue without granting access."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart може читати й записувати зразки самопочуття (пульс, ВСР, сон, тренування, маса тіла, гідратація), щоб покращувати оцінки на пристрої. Дані не використовуються для реклами і не надсилаються стороннім сервісам. Можна продовжити без доступу."
          }
        }
      }
    },
    "perm_explainer_bluetooth_title": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth accessories"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth-аксесуари"
          }
        }
      }
    },
    "perm_explainer_bluetooth_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a heart-rate or similar fitness accessory for live samples. OmniGart works fully without Bluetooth."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть пульсометр або подібний фітнес-аксесуар для живих зразків. OmniGart повністю працює без Bluetooth."
          }
        }
      }
    },
    "perm_explainer_camera_title": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera for barcodes"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера для штрихкодів"
          }
        }
      }
    },
    "perm_explainer_camera_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used only to scan food barcodes. You can log food manually if you deny access."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера використовується лише для сканування штрихкодів продуктів. Їжу можна додавати вручну, якщо відмовите в доступі."
          }
        }
      }
    },
    "perm_explainer_notifications_title": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування"
          }
        }
      }
