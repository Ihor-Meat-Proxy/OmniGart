    "health_wellness_note": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellness display only — not medical advice. OmniGart never writes or deletes these health records from this tab."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише відображення добробуту — не медична порада. OmniGart ніколи не записує й не видаляє ці записи здоров’я з цієї вкладки."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko wyświetlanie wellness — nie porada medyczna. OmniGart nigdy nie zapisuje ani nie usuwa tych rekordów zdrowia z tej karty."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі адлюстраванне дабрабыту — не медыцынская парада. OmniGart ніколі не запісвае і не выдаляе гэтыя запісы здароўя з гэтай укладкі."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек сауықтыру көрсетілімі — медициналық кеңес емес. OmniGart осы қойыншықтан бұл денсаулық жазбаларын ешқашан жазбайды және жоймайды."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ კეთილდღეობის ჩვენება — არა სამედიცინო რჩევა. OmniGart ამ ჩანართიდან ამ ჯანმრთელობის ჩანაწერებს არასდროს წერს ან შლის."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo visualización de bienestar — no consejo médico. OmniGart nunca escribe ni elimina estos registros de salud desde esta pestaña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage bien-être uniquement — pas un avis médical. OmniGart n’écrit ni ne supprime jamais ces enregistrements depuis cet onglet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Wellness-Anzeige — keine medizinische Beratung. OmniGart schreibt oder löscht diese Gesundheitsdaten von diesem Tab nie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen wellness zobrazení — ne lékařská rada. OmniGart z této karty tyto zdravotní záznamy nikdy nezapisuje ani nemaže."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为健康展示，不是医疗建议。OmniGart 不会从此页写入或删除这些健康记录。"
          }
        }
      }
    },
