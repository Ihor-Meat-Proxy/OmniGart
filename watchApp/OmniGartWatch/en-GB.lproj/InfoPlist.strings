/* en-GB — Watch HealthKit, Bluetooth, camera, notifications */
"NSHealthShareUsageDescription" = "OmniGart on Apple Watch reads heart rate, HRV, workouts, and active and resting energy from Apple Health to show on-watch wellness estimates. If a sample is later removed from Apple Health, OmniGart keeps your on-device copy. Health data is not used for advertising or shared with third parties.";
"NSHealthUpdateUsageDescription" = "OmniGart on Apple Watch saves strength, yoga, Pilates, and Zone 2 workouts — with duration, active and resting energy, heart rate, and segments — to Apple Health so they appear in the Fitness app. Writes are append-only: OmniGart never deletes or rewrites Apple Health data, including its own; later edits stay in OmniGart. Data is not used for ads or sold to third parties.";
"NSBluetoothAlwaysUsageDescription" = "OmniGart may use Bluetooth during an indoor treadmill run to read speed, incline, and distance from a compatible treadmill, and for heart-rate accessories you choose. The watch app remains usable without an accessory.";
"NSCameraUsageDescription" = "Camera access is not required on Apple Watch for OmniGart; this description exists for shared permission strings with the iPhone app.";
"NSUserNotificationsUsageDescription" = "OmniGart can remind you about workouts and wellness check-ins you enable. The app works with notifications disabled.";
