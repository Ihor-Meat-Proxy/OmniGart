            "value": "Құрылғыда жаттығуларды жоспарлаңыз және қаласаңыз 2-аймақ жүгіруін Workout-қа қосыңыз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაგეგმეთ ვარჯიშები მოწყობილობაზე და სურვილისამებრ დაამატეთ ზონა 2 სირბილი Workout-ში."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica entrenamientos en el dispositivo y, si quieres, programa una carrera zona 2 en Workout."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifiez des séances sur l’appareil et, en option, une course zone 2 dans Workout."
          }
