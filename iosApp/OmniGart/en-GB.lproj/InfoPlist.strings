/* en-GB — HealthKit, Bluetooth, camera, notifications purpose strings */
"NSHealthShareUsageDescription" = "OmniGart reads heart rate, HRV, sleep, workouts, active and resting energy, body mass, and related wellness samples from Apple Health so it can show readiness, recovery, and training estimates on your device. Health data stays on your devices and is never used for advertising or sold to third parties.";
"NSHealthUpdateUsageDescription" = "OmniGart writes workouts you log — with duration, active and resting energy, and heart rate when available — plus wellness metrics you choose to share (such as body mass or hydration) into Apple Health so they appear in the Fitness app and stay in sync across your devices. Nothing is sent to advertisers or unrelated third parties.";
"NSBluetoothAlwaysUsageDescription" = "OmniGart uses Bluetooth to connect to heart-rate and similar fitness accessories you choose, so live samples can improve on-device wellness estimates. You can keep using the app without connecting any accessory.";
"NSCameraUsageDescription" = "OmniGart uses the camera only when you scan a food barcode to look up nutrition information. You can log food manually if you prefer not to allow camera access.";
"NSUserNotificationsUsageDescription" = "OmniGart can send reminders for workouts, hydration, and morning wellness check-ins you opt into. You can use the app fully with notifications turned off.";
