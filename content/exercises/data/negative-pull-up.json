  "technique": [
    "Jump or step to the top chin-over-bar position, then lower for 3–5+ seconds to a full hang.",
    "Reset at the top each rep; do not bounce out of the bottom."
  ],
  "setup": [
    "Box or jump access to the top; choose pronated, neutral, or chin-up grip."
  ],
  "breathing": "Inhale or brace through the slow descent; avoid panic breath-holds.",
  "commonMistakes": [
    "Dropping the last third of the ROM",
    "Excessive kip to the top"
  ],
  "safety": [
    "High eccentric fatigue — low volume; recover between sessions."
  ],
