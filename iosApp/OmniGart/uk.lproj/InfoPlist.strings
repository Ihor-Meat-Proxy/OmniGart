/* uk — HealthKit, Bluetooth, camera, notifications purpose strings */
"NSHealthShareUsageDescription" = "OmniGart читає частоту пульсу, ВСР, сон, тренування, масу тіла та пов’язані показники самопочуття з Apple Health, щоб показувати оцінки готовності, відновлення й тренувань на ваших пристроях. Дані здоров’я залишаються на ваших пристроях і ніколи не використовуються для реклами та не продаються третім сторонам.";
"NSHealthUpdateUsageDescription" = "OmniGart записує тренування, які ви журналюєте, і обрані вами показники самопочуття (наприклад масу тіла чи гідратацію) в Apple Health, щоб історія синхронізувалася між пристроями. Нічого не надсилається рекламодавцям чи стороннім сервісам.";
"NSBluetoothAlwaysUsageDescription" = "OmniGart використовує Bluetooth для підключення пульсометрів та подібних фітнес-аксесуарів за вашим вибором, щоб покращувати оцінки самопочуття на пристрої. Додаток працює і без аксесуара.";
"NSCameraUsageDescription" = "OmniGart використовує камеру лише коли ви скануєте штрихкод продукту для пошуку поживної інформації. Їжу можна додавати вручну без доступу до камери.";
"NSUserNotificationsUsageDescription" = "OmniGart може надсилати нагадування про тренування, гідратацію та ранкові перевірки самопочуття, якщо ви їх увімкнете. Додаток повністю працює з вимкненими сповіщеннями.";
