    "planner_wellness_note": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions are wellness guides only, not medical advice. Plans stay in the app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підказки — лише wellness-орієнтири, не медична порада. Плани лишаються в застосунку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpowiedzi to tylko wskazówki wellness, nie porada medyczna. Plany zostają w aplikacji."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падказкі — толькі wellness-арыенціры, не медыцынская парада. Планы застаюцца ў праграме."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ұсыныстар тек сауықтыру бағдары, медициналық кеңес емес. Жоспарлар қолданбада қалады."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რჩევები მხოლოდ კეთილდღეობის სახელმძღვანელოა, არა სამედიცინო კონსულტაცია. გეგმები აპში რჩება."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias son guías de bienestar, no consejo médico. Los planes se quedan en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions sont des guides bien-être, pas un avis médical. Les plans restent dans l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge sind nur Wellness-Hinweise, keine medizinische Beratung. Pläne bleiben in der App."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipy jsou jen wellness vodítka, ne lékařská rada. Plány zůstávají v aplikaci."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议仅为健康参考，不是医疗意见。计划仅保存在应用内。"
          }
        }
      }
