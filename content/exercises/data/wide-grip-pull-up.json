  "technique": [
    "Pronated grip clearly wider than shoulders (avoid extreme snatch-grip widths that irritate the shoulder).",
    "Pull elbows down toward the sides until the chin clears; lower fully."
  ],
  "setup": [
    "Mark a sustainable wide grip; do not chase maximal width."
  ],
  "breathing": "Exhale on the pull.",
  "commonMistakes": [
    "Excessively wide grip that forces painful shoulder positions",
    "Chicken-wing elbows"
  ],
  "safety": [
    "Wide grips can increase shoulder stress — stay within a comfortable scapular plane."
  ],
  "contraindications": [
    "Symptomatic shoulder impingement without clearance"
  ],
