    "watch_equipment_sync_hint": {
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggles sync from iPhone. Changes apply to this session only."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикачі синхронізуються з iPhone. Зміни лише для цієї сесії."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełączniki synchronizują się z iPhone’a. Zmiany tylko dla tej sesji."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пераключальнікі сінхранізуюцца з iPhone. Змены толькі для гэтай сесіі."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ауыстырғыштар iPhone-нан синхрондалады. Өзгерістер тек осы сессияға."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადამრთველები სინქრონდება iPhone-დან. ცვლილებები მხოლოდ ამ სესიისთვის."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los interruptores se sincronizan desde el iPhone. Solo para esta sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bascules se synchronisent depuis l’iPhone. Uniquement pour cette séance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalter synchronisieren vom iPhone. Nur für diese Einheit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínače se synchronizují z iPhonu. Jen pro tuto jednotku."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开关与 iPhone 同步。仅作用于本次课次。"
          }
        }
      }
    },
