  "trackingType": "bodyweight_reps",
  "technique": [
    "Support on parallel bars with locked elbows; lean slightly forward for chest emphasis or stay more upright for triceps.",
    "Descend by bending the elbows until upper arms approach parallel to the floor (or a pain-free depth), then press to lockout."
  ],
  "setup": [
    "Bars stable; shoulders packed down; avoid end-range extension if symptomatic."
  ],
  "breathing": "Inhale on the descent; exhale to press.",
  "commonMistakes": [
    "Dumping into painful end-range shoulder extension",
    "Swinging the legs for momentum"
  ],
  "safety": [
    "Limit depth to avoid end-range glenohumeral extension when irritable (McKenzie et al. 2020).",
    "Use assistance before adding load; stop with anterior shoulder pain."
  ],
  "contraindications": [
    "Anterior shoulder instability",
    "Acute pec strain"
  ],
