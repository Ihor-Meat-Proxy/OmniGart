    "perm_explainer_health_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart can read and write wellness samples — heart rate, HRV, sleep, workouts, active and resting energy, body mass, and hydration — so sessions can appear in Apple Fitness with duration and calories. Data is not used for ads or sent to unrelated third parties. You can continue without granting access."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart може читати й записувати зразки самопочуття — пульс, ВСР, сон, тренування, активну й базальну енергію, масу тіла та гідратацію — щоб сесії з’являлися в Apple Fitness із тривалістю та калоріями. Дані не використовуються для реклами й не передаються стороннім. Можна продовжити без доступу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart może czytać i zapisywać próbki wellness — tętno, HRV, sen, treningi, energię aktywną i spoczynkową, masę ciała i nawodnienie — aby sesje pojawiały się w Apple Fitness z czasem i kaloriami. Dane nie służą reklamom ani stronom trzecim. Możesz kontynuować bez dostępu."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart можа чытаць і запісваць узоры самаадчування — пульс, ВСР, сон, трэніроўкі, актыўную і базальную энергію, масу цела і гідратацыю — каб сесіі з’яўляліся ў Apple Fitness з працягласцю і калорыямі. Дадзеныя не для рэкламы і не перадаюцца трэцім бакам. Можна працягнуць без доступу."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart сауықтыру үлгілерін оқи және жаза алады — жүрек соғысы, HRV, ұйқы, жаттығулар, белсенді және базалық энергия, дене салмағы және су ішу — сеанстар Apple Fitness-те ұзақтық пен калориямен көрінуі үшін. Деректер жарнамаға немесе үшінші тарапқа берілмейді. Рұқсатсыз жалғастыруға болады."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart-ს შეუძლია წაიკითხოს და ჩაწეროს კეთილდღეობის ნიმუშები — გულისცემა, HRV, ძილი, ვარჯიშები, აქტიური და საბაზისო ენერგია, სხეულის მასა და ჰიდრატაცია — რომ სესიები გამოჩნდეს Apple Fitness-ში ხანგრძლივობით და კალორიებით. მონაცემები არ გამოიყენება რეკლამისთვის. შეგიძლიათ გააგრძელოთ წვდომის გარეშე."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart puede leer y escribir muestras de bienestar — frecuencia cardiaca, VFC, sueño, entrenamientos, energía activa y en reposo, masa corporal e hidratación — para que las sesiones aparezcan en Apple Fitness con duración y calorías. Los datos no se usan para publicidad. Puedes continuar sin conceder acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart peut lire et écrire des échantillons bien-être — fréquence cardiaque, VRC, sommeil, séances, énergie active et basale, masse corporelle et hydratation — pour afficher les séances dans Apple Fitness avec durée et calories. Les données ne servent pas à la pub. Vous pouvez continuer sans accorder l’accès."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart kann Wellness-Proben lesen und schreiben — Herzfrequenz, HRV, Schlaf, Workouts, aktive und Ruheenergie, Körpermasse und Hydration — damit Sitzungen in Apple Fitness mit Dauer und Kalorien erscheinen. Daten werden nicht für Werbung genutzt. Sie können ohne Zugriff fortfahren."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart může číst a zapisovat wellness vzorky — tep, HRV, spánek, tréninky, aktivní a bazální energii, tělesnou hmotnost a hydrataci — aby se sezení zobrazila v Apple Fitness s délkou a kaloriemi. Data se nepoužívají k reklamě. Můžete pokračovat bez přístupu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart 可读写健康样本——心率、心率变异、睡眠、训练、活动与基础能量、体重和补水——以便会话以时长和热量出现在 Apple Fitness 中。数据不用于广告，也不发送给无关第三方。您也可不授予权限并继续。"
          }
        }
      }
    },
