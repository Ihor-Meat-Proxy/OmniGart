    "workout_mindful_minutes_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Off by default. Writes a mindful session only when you enable this."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За бажанням. Типово вимкнено. Записує mindful-сесію лише коли ви це вмикаєте."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Domyślnie wyłączone. Zapisuje sesję uważności tylko po włączeniu."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Па жаданні. Па змаўчанні выключана. Запісвае mindful-сесію толькі калі ўключана."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосымша. Әдепкі өшірулі. Тек қосқанда mindful сеансын жазады."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სურვილისამებრ. ნაგულისხმევად გამორთულია. იწერს მხოლოდ ჩართვისას."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Desactivado por defecto. Solo escribe si lo activas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionnel. Désactivé par défaut. N’écrit que si vous l’activez."
