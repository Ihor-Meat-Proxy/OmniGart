            "state": "translated",
            "value": "Course tapis"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufband-Lauf"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běh na pásu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跑步机跑步"
          }
        }
      }
    },
    "treadmill_run_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a compatible treadmill for live speed, incline, and distance. Without a link, the watch estimates distance — you can calibrate after."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть сумісну доріжку для живої швидкості, нахилу та дистанції. Без зв’язку годинник оцінює дистанцію — можна відкалібрувати після."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz zgodną bieżnię, by widzieć prędkość, nachylenie i dystans. Bez połączenia zegarek szacuje dystans — możesz skalibrować później."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падключыце сумяшчальную дарожку для хуткасці, нахілу і дыстанцыі. Без сувязі гадзіннік ацэньвае дыстанцыю — можна адкалібраваць пасля."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жылдамдық, еңіс және қашықтық үшін үйлесімді жүгіру жолын қосыңыз. Байланыс болмаса сағат қашықтықты бағалайды — кейін калибрлеуге болады."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დააკავშირეთ თავსებადი სარბენი ბილიკი სიჩქარის, დახრისა და დისტანციისთვის. კავშირის გარეშე საათი აფასებს დისტანციას — შემდეგ შეგიძლიათ დააკალიბროთ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una cinta compatible para ver velocidad, inclinación y distancia. Sin enlace, el reloj estima la distancia; puedes calibrar después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un tapis compatible pour la vitesse, la pente et la distance. Sans lien, la montre estime la distance — calibrage possible après."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde ein kompatibles Laufband für Tempo, Steigung und Distanz. Ohne Verbindung schätzt die Watch die Distanz — danach kalibrierbar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte kompatibilní pás pro rychlost, sklon a vzdálenost. Bez spojení hodinky odhadnou vzdálenost — poté můžete kalibrovat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接兼容跑步机以查看速度、坡度和距离。未连接时由手表估算距离，结束后可校准。"
          }
        }
      }
    },
