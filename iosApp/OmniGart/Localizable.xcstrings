            "value": "Une pesée aide à personnaliser votre objectif énergétique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wiegen hilft, Ihr Energieziel persönlicher zu halten."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvážení pomáhá udržet energetický cíl osobní."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录体重有助于让能量目标更贴合您。"
          }
