          "stringUnit": {
            "state": "translated",
            "value": "Якщо маєте стан здоров’я, вагітні або молодші за 18, звертесь до фахівця."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli masz problem zdrowotny, jesteś w ciąży lub masz mniej niż 18 lat, skonsultuj się ze specjalistą."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі маеце стан здароўя, цяжарныя ці маладзейшыя за 18, звярніцеся да спецыяліста."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Денсаулық жағдайы болса, жүкті болсаңыз немесе 18 жасқа толмасаңыз, маманға қаралыңыз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ გაქვთ ჯანმრთელობის მდგომარეობა, ორსულად ხართ ან 18 წლამდე ხართ, მიმართეთ სპეციალისტს."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes una condición de salud, estás embarazada o eres menor de 18, consulta a un profesional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas de problème de santé, de grossesse ou si vous avez moins de 18 ans, consultez un professionnel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei einer Erkrankung, Schwangerschaft oder unter 18 Jahren bitte Fachperson fragen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud máte zdravotní potíže, jste těhotná nebo mladší 18 let, poraďte se s odborníkem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如有健康状况、怀孕或未满 18 岁，请咨询专业人士。"
          }
        }
      }
    },
