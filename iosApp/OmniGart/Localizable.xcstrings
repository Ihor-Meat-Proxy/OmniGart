    "perm_explainer_notifications_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional reminders for workouts, hydration, and morning wellness check-ins. The app stays usable with notifications off."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язкові нагадування про тренування, гідратацію та ранкові перевірки самопочуття. Додаток працює зі вимкненими сповіщеннями."
          }
        }
      }
    },
