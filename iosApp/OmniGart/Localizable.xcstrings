          "stringUnit": {
            "state": "translated",
            "value": "Plan breve para este nivel y lugar. Solo orientación de entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan court pour ce niveau et ce lieu. Aide à l’entraînement uniquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzer Plan für dieses Niveau und diesen Ort. Nur Trainingshilfe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátký plán pro tuto úroveň a místo. Pouze tréninková nápověda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合该水平与场地的简明计划。仅供训练参考。"
