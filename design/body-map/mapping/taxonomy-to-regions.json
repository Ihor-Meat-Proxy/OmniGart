{
  "$schema": "./taxonomy-to-regions.schema.json",
  "version": 1,
  "description": "Maps exercise-library muscle taxonomy ids to fine-grained body-map region ids. Taxonomy ids stay stable; SVG paths use finer anatomy (Terminologia Anatomica naming).",
  "naming": {
    "authority": "Terminologia Anatomica (TA2) preferred English terms",
    "notes": [
      "Exercise taxonomy is coarser than the drawn regions (e.g. pectoralis_major → clavicular + sternal heads).",
      "Bilateral regions use _l / _r suffixes; mapping lists both unless noted.",
      "full_body expands to every drawable muscle region on both views.",
      "transverse_abdominis has no surface silhouette; mapped to rectus_abdominis + obliques as a surface proxy.",
      "rotator_cuff has no dedicated surface mass; mapped to a small shoulder-girdle proxy near the deltoid/scapula junction."
    ]
  },
  "mappings": {
    "pectoralis_major": {
      "views": ["front"],
      "regions": [
        "pectoralis_major_clavicular_l",
        "pectoralis_major_clavicular_r",
        "pectoralis_major_sternal_l",
        "pectoralis_major_sternal_r"
      ]
    },
    "front_deltoid": {
      "views": ["front"],
      "regions": ["front_deltoid_l", "front_deltoid_r"]
    },
    "lateral_deltoid": {
      "views": ["front", "back"],
      "regions": [
        "lateral_deltoid_l",
        "lateral_deltoid_r",
        "lateral_deltoid_back_l",
        "lateral_deltoid_back_r"
      ]
    },
    "rear_deltoid": {
      "views": ["back"],
      "regions": ["rear_deltoid_l", "rear_deltoid_r"]
    },
    "biceps": {
      "views": ["front"],
      "regions": ["biceps_l", "biceps_r", "brachialis_l", "brachialis_r"]
    },
    "triceps": {
      "views": ["back"],
      "regions": ["triceps_l", "triceps_r"]
    },
    "forearms": {
      "views": ["front", "back"],
      "regions": [
        "forearm_flexors_l",
        "forearm_flexors_r",
        "forearm_extensors_l",
        "forearm_extensors_r"
      ]
    },
    "rectus_abdominis": {
      "views": ["front"],
      "regions": ["rectus_abdominis"]
    },
    "obliques": {
      "views": ["front"],
      "regions": ["obliques_l", "obliques_r"]
    },
    "transverse_abdominis": {
      "views": ["front"],
      "regions": ["rectus_abdominis", "obliques_l", "obliques_r"],
      "proxy": true
    },
    "serratus_anterior": {
      "views": ["front"],
      "regions": ["serratus_anterior_l", "serratus_anterior_r"]
    },
    "trapezius": {
      "views": ["back"],
      "regions": [
        "trapezius_upper_l",
        "trapezius_upper_r",
        "trapezius_middle"
      ]
    },
    "rhomboids": {
      "views": ["back"],
      "regions": ["rhomboids_l", "rhomboids_r"]
    },
    "latissimus_dorsi": {
      "views": ["back"],
      "regions": ["latissimus_dorsi_l", "latissimus_dorsi_r"]
    },
    "erector_spinae": {
      "views": ["back"],
      "regions": ["erector_spinae_l", "erector_spinae_r"]
    },
    "gluteus_maximus": {
      "views": ["back"],
      "regions": ["gluteus_maximus_l", "gluteus_maximus_r"]
    },
    "gluteus_medius": {
      "views": ["back"],
      "regions": ["gluteus_medius_l", "gluteus_medius_r"]
    },
    "adductors": {
      "views": ["front"],
      "regions": ["adductors_l", "adductors_r"]
    },
    "hip_flexors": {
      "views": ["front"],
      "regions": ["hip_flexors_l", "hip_flexors_r"]
    },
    "quadriceps": {
      "views": ["front"],
      "regions": [
        "rectus_femoris_l",
        "rectus_femoris_r",
        "vastus_lateralis_l",
        "vastus_lateralis_r",
        "vastus_medialis_l",
        "vastus_medialis_r"
      ]
    },
    "hamstrings": {
      "views": ["back"],
      "regions": ["hamstrings_l", "hamstrings_r"]
    },
    "calves": {
      "views": ["back", "front"],
      "regions": [
        "gastrocnemius_l",
        "gastrocnemius_r",
        "soleus_l",
        "soleus_r",
        "gastrocnemius_front_l",
        "gastrocnemius_front_r"
      ]
    },
    "tibialis_anterior": {
      "views": ["front"],
      "regions": ["tibialis_anterior_l", "tibialis_anterior_r"]
    },
    "neck": {
      "views": ["front", "back"],
      "regions": ["neck_front", "neck_back"]
    },
    "rotator_cuff": {
      "views": ["back"],
      "regions": ["rotator_cuff_l", "rotator_cuff_r"],
      "proxy": true
    },
    "full_body": {
      "views": ["front", "back"],
      "regions": ["*"],
      "proxy": true
    }
  }
}
