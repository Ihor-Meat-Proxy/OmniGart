{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnigart.dev/schemas/evidence-entry.schema.json",
  "title": "OmniGartEvidenceEntry",
  "description": "A single citable evidence source used by statements, goals, formulas, and plans. GRADE rules: content/evidence/GRADE_RULES.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "authors",
    "year",
    "keyFinding",
    "evidenceStrength",
    "licenceNote",
    "retracted",
    "lastVerified",
    "openAccess"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable snake_case evidence id, e.g. schoenfeld_volume_2016",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
      "minLength": 4,
      "maxLength": 80
    },
    "type": {
      "type": "string",
      "enum": [
        "meta-analysis",
        "systematic-review",
        "rct",
        "cohort",
        "guideline",
        "textbook",
        "consensus"
      ]
    },
    "title": { "type": "string", "minLength": 8 },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
    "journal": { "type": "string", "minLength": 2 },
    "doi": {
      "type": "string",
      "description": "Bare DOI without https://doi.org/ prefix",
      "pattern": "^10\\.\\d{4,9}/\\S+$"
    },
    "pmid": {
      "type": "string",
      "pattern": "^[0-9]{4,12}$"
    },
    "pmcid": {
      "type": "string",
      "pattern": "^PMC[0-9]+$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "openAccess": {
      "type": "boolean",
      "description": "True when a free full-text copy is known to be available (publisher OA, PMC, or agency report)."
    },
    "sampleSize": {
      "type": "integer",
      "minimum": 1,
      "description": "Primary analysis N when reported (participants, studies, or arms as noted in population)."
    },
    "population": {
      "type": "string",
      "minLength": 4,
      "description": "Who was studied / who the guidance applies to (neutral, concise)."
    },
    "keyFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enGB", "keys"],
      "properties": {
        "enGB": {
          "type": "string",
          "minLength": 20,
          "maxLength": 320,
          "description": "Short neutral en-GB summary suitable for the ⓘ sheet."
        },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enGB", "uk"],
          "properties": {
            "enGB": {
              "type": "string",
              "pattern": "^evidence\\.[a-z0-9_]+\\.key_finding$"
            },
            "uk": {
              "type": "string",
              "pattern": "^evidence\\.[a-z0-9_]+\\.key_finding$"
            }
          }
        }
      }
    },
    "evidenceStrength": {
      "type": "string",
      "enum": ["high", "moderate", "low", "very-low"],
      "description": "GRADE-inspired grade; see GRADE_RULES.md"
    },
    "licenceNote": {
      "type": "string",
      "minLength": 8,
      "description": "How the title/finding may be quoted in-app (fair dealing / publisher terms)."
    },
    "retracted": {
      "type": "boolean",
      "description": "True if Crossref update-to / Retraction Watch flags a retraction or expression of concern that invalidates use."
    },
    "lastVerified": {
      "type": "string",
      "format": "date",
      "description": "ISO date (YYYY-MM-DD) of last successful DOI/PMID resolve + metadata check."
    },
    "usedBy": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "description": "Optional module/formula/content identifiers that cite this entry."
    }
  }
}
