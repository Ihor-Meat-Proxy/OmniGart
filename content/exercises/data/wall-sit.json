  "technique": [
    "Slide the back down a wall until thighs are near parallel; hold with knees tracking over mid-foot and heels down."
  ],
  "setup": [
    "Feet roughly hip-width and away from the wall so shins can stay vertical."
  ],
  "breathing": "Steady breathing; do not hold the breath.",
  "commonMistakes": [
    "Knees collapsing inward",
    "Heels rising"
  ],
