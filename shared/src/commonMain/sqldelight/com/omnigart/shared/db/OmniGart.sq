CREATE TABLE user_profile (
  id TEXT NOT NULL PRIMARY KEY,
  biological_sex TEXT NOT NULL,
  height_cm REAL NOT NULL,
  weight_kg REAL NOT NULL,
  date_of_birth TEXT NOT NULL,
  preferred_units TEXT NOT NULL,
  waist_cm REAL,
  hip_cm REAL,
  primary_goal TEXT NOT NULL DEFAULT 'GENERAL_FITNESS',
  strength_level TEXT NOT NULL DEFAULT 'BEGINNER',
  activity_level TEXT NOT NULL DEFAULT 'MODERATE',
  onboarding_completed INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE exercise (
  id TEXT NOT NULL PRIMARY KEY,
  content_key TEXT NOT NULL,
  modality TEXT NOT NULL,
  primary_muscles TEXT NOT NULL DEFAULT ''
);

CREATE TABLE workout (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  notes TEXT,
  exercise_ids TEXT NOT NULL DEFAULT ''
);

CREATE TABLE session (
  id TEXT NOT NULL PRIMARY KEY,
  workout_id TEXT,
  started_at TEXT NOT NULL,
  ended_at TEXT,
  perceived_exertion INTEGER,
  notes TEXT
);

CREATE TABLE workout_set (
  id TEXT NOT NULL PRIMARY KEY,
  session_id TEXT NOT NULL,
  exercise_id TEXT NOT NULL,
  set_index INTEGER NOT NULL,
  reps INTEGER,
  weight_kg REAL,
  duration_seconds INTEGER,
  distance_metres REAL,
  rir REAL,
  rpe REAL,
  completed INTEGER NOT NULL DEFAULT 1,
  is_warmup INTEGER NOT NULL DEFAULT 0,
  is_drop_set INTEGER NOT NULL DEFAULT 0,
  is_failure INTEGER NOT NULL DEFAULT 0,
  assistance_kg REAL,
  logged_per_hand INTEGER NOT NULL DEFAULT 0,
  note TEXT,
  rest_seconds INTEGER,
  target_weight_kg REAL,
  target_reps INTEGER,
  FOREIGN KEY(session_id) REFERENCES session(id) ON DELETE CASCADE
);

selectProfile:
SELECT * FROM user_profile WHERE id = ?;

selectAllProfiles:
SELECT * FROM user_profile;

upsertProfile:
INSERT OR REPLACE INTO user_profile(
  id, biological_sex, height_cm, weight_kg, date_of_birth, preferred_units, waist_cm, hip_cm,
  primary_goal, strength_level, activity_level, onboarding_completed
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteProfile:
DELETE FROM user_profile WHERE id = ?;

selectExercise:
SELECT * FROM exercise WHERE id = ?;

selectAllExercises:
SELECT * FROM exercise;

upsertExercise:
INSERT OR REPLACE INTO exercise(id, content_key, modality, primary_muscles)
VALUES (?, ?, ?, ?);

selectWorkout:
SELECT * FROM workout WHERE id = ?;

selectAllWorkouts:
SELECT * FROM workout;

upsertWorkout:
INSERT OR REPLACE INTO workout(id, name, notes, exercise_ids)
VALUES (?, ?, ?, ?);

selectSession:
SELECT * FROM session WHERE id = ?;

selectAllSessions:
SELECT * FROM session ORDER BY started_at DESC;

upsertSession:
INSERT OR REPLACE INTO session(id, workout_id, started_at, ended_at, perceived_exertion, notes)
VALUES (?, ?, ?, ?, ?, ?);

selectSetsForSession:
SELECT * FROM workout_set WHERE session_id = ? ORDER BY set_index ASC;

upsertSet:
INSERT OR REPLACE INTO workout_set(
  id, session_id, exercise_id, set_index, reps, weight_kg, duration_seconds, distance_metres, rir, rpe, completed,
  is_warmup, is_drop_set, is_failure, assistance_kg, logged_per_hand, note, rest_seconds, target_weight_kg, target_reps
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSet:
DELETE FROM workout_set WHERE id = ?;

deleteSetsForSession:
DELETE FROM workout_set WHERE session_id = ?;


CREATE TABLE food_entry (
  id TEXT NOT NULL PRIMARY KEY,
  profile_id TEXT NOT NULL,
  name TEXT NOT NULL,
  energy_kcal REAL NOT NULL DEFAULT 0,
  protein_g REAL NOT NULL DEFAULT 0,
  carbs_g REAL NOT NULL DEFAULT 0,
  fat_g REAL NOT NULL DEFAULT 0,
  logged_at TEXT NOT NULL
);

selectFoodEntriesForProfileDay:
SELECT * FROM food_entry
WHERE profile_id = ? AND logged_at >= ? AND logged_at < ?
ORDER BY logged_at DESC;

upsertFoodEntry:
INSERT OR REPLACE INTO food_entry(
  id, profile_id, name, energy_kcal, protein_g, carbs_g, fat_g, logged_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteFoodEntry:
DELETE FROM food_entry WHERE id = ?;

CREATE TABLE formula_settings (
  profile_id TEXT NOT NULL PRIMARY KEY,
  mode TEXT NOT NULL,
  bmr_key TEXT NOT NULL,
  hr_max_key TEXT NOT NULL,
  body_fat_key TEXT NOT NULL,
  one_rm_key TEXT NOT NULL,
  hr_zones_key TEXT NOT NULL,
  updated_at TEXT NOT NULL
);

CREATE TABLE derived_estimate (
  id TEXT NOT NULL PRIMARY KEY,
  profile_id TEXT NOT NULL,
  domain TEXT NOT NULL,
  formula_key TEXT NOT NULL,
  weight_kg REAL,
  height_cm REAL,
  age_years INTEGER,
  biological_sex TEXT,
  reps INTEGER,
  resting_bpm REAL,
  max_bpm REAL,
  estimate_value REAL NOT NULL,
  unit TEXT NOT NULL,
  computed_at TEXT NOT NULL
);

CREATE TABLE formula_recalc_audit (
  id TEXT NOT NULL PRIMARY KEY,
  profile_id TEXT NOT NULL,
  domain TEXT NOT NULL,
  old_formula_key TEXT NOT NULL,
  new_formula_key TEXT NOT NULL,
  rows_touched INTEGER NOT NULL,
  at TEXT NOT NULL
);

selectFormulaSettings:
SELECT * FROM formula_settings WHERE profile_id = ?;

upsertFormulaSettings:
INSERT OR REPLACE INTO formula_settings(
  profile_id, mode, bmr_key, hr_max_key, body_fat_key, one_rm_key, hr_zones_key, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectEstimatesForProfileDomain:
SELECT * FROM derived_estimate
WHERE profile_id = ? AND domain = ?
ORDER BY computed_at ASC;

selectEstimatesForProfile:
SELECT * FROM derived_estimate WHERE profile_id = ? ORDER BY computed_at ASC;

upsertDerivedEstimate:
INSERT OR REPLACE INTO derived_estimate(
  id, profile_id, domain, formula_key, weight_kg, height_cm, age_years, biological_sex,
  reps, resting_bpm, max_bpm, estimate_value, unit, computed_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDerivedEstimateValue:
UPDATE derived_estimate SET formula_key = ?, estimate_value = ?, computed_at = ? WHERE id = ?;

insertRecalcAudit:
INSERT INTO formula_recalc_audit(
  id, profile_id, domain, old_formula_key, new_formula_key, rows_touched, at
) VALUES (?, ?, ?, ?, ?, ?, ?);

selectRecalcAuditsForProfile:
SELECT * FROM formula_recalc_audit WHERE profile_id = ? ORDER BY at DESC;

-- Local-first health store (canonical OmniGart copy; platform sync is optional).

CREATE TABLE local_health_workout (
  id TEXT NOT NULL PRIMARY KEY,
  sync_identifier TEXT NOT NULL,
  sync_version INTEGER NOT NULL DEFAULT 1,
  activity_type TEXT NOT NULL,
  start_at TEXT NOT NULL,
  end_at TEXT NOT NULL,
  active_energy_kcal REAL,
  basal_energy_kcal REAL,
  distance_metres REAL,
  steps INTEGER,
  average_heart_rate_bpm REAL,
  max_heart_rate_bpm REAL,
  average_cadence_spm REAL,
  plan_id TEXT,
  session_id TEXT,
  origin TEXT NOT NULL,
  source_bundle TEXT,
  source_name TEXT,
  platform_record_id TEXT,
  deleted INTEGER NOT NULL DEFAULT 0,
  removed_from_platform INTEGER NOT NULL DEFAULT 0,
  updated_at TEXT NOT NULL,
  notes TEXT
);

CREATE TABLE local_health_sample (
  id TEXT NOT NULL PRIMARY KEY,
  workout_id TEXT NOT NULL,
  sample_type TEXT NOT NULL,
  recorded_at TEXT NOT NULL,
  end_at TEXT,
  value REAL NOT NULL,
  unit TEXT NOT NULL,
  FOREIGN KEY(workout_id) REFERENCES local_health_workout(id) ON DELETE CASCADE
);

CREATE TABLE local_health_route_point (
  id TEXT NOT NULL PRIMARY KEY,
  workout_id TEXT NOT NULL,
  recorded_at TEXT NOT NULL,
  latitude REAL NOT NULL,
  longitude REAL NOT NULL,
  altitude_metres REAL,
  point_index INTEGER NOT NULL,
  FOREIGN KEY(workout_id) REFERENCES local_health_workout(id) ON DELETE CASCADE
);

CREATE TABLE local_health_event (
  id TEXT NOT NULL PRIMARY KEY,
  workout_id TEXT NOT NULL,
  event_type TEXT NOT NULL,
  start_at TEXT NOT NULL,
  end_at TEXT,
  label TEXT,
  event_index INTEGER NOT NULL,
  FOREIGN KEY(workout_id) REFERENCES local_health_workout(id) ON DELETE CASCADE
);

CREATE TABLE local_health_set (
  id TEXT NOT NULL PRIMARY KEY,
  workout_id TEXT NOT NULL,
  exercise_key TEXT NOT NULL,
  set_index INTEGER NOT NULL,
  reps INTEGER,
  load_kg REAL,
  duration_seconds INTEGER,
  distance_metres REAL,
  rir REAL,
  rpe REAL,
  is_warmup INTEGER NOT NULL DEFAULT 0,
  is_drop_set INTEGER NOT NULL DEFAULT 0,
  is_failure INTEGER NOT NULL DEFAULT 0,
  note TEXT,
  FOREIGN KEY(workout_id) REFERENCES local_health_workout(id) ON DELETE CASCADE
);

CREATE TABLE health_sync_state (
  platform TEXT NOT NULL PRIMARY KEY,
  change_token TEXT,
  last_sync_at TEXT,
  auth_status TEXT NOT NULL DEFAULT 'NOT_DETERMINED'
);

CREATE TABLE health_conflict (
  id TEXT NOT NULL PRIMARY KEY,
  workout_id TEXT NOT NULL,
  platform TEXT NOT NULL,
  field_name TEXT NOT NULL,
  local_value TEXT,
  platform_value TEXT,
  preferred_source TEXT NOT NULL,
  resolved INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL,
  FOREIGN KEY(workout_id) REFERENCES local_health_workout(id) ON DELETE CASCADE
);

CREATE INDEX local_health_workout_sync_idx ON local_health_workout(sync_identifier);
CREATE INDEX local_health_workout_start_idx ON local_health_workout(start_at);
CREATE INDEX local_health_sample_workout_idx ON local_health_sample(workout_id);
CREATE INDEX local_health_route_workout_idx ON local_health_route_point(workout_id);
CREATE INDEX health_conflict_open_idx ON health_conflict(resolved);

selectLocalHealthWorkout:
SELECT * FROM local_health_workout WHERE id = ?;

selectLocalHealthWorkoutBySyncId:
SELECT * FROM local_health_workout WHERE sync_identifier = ? AND deleted = 0;

selectLocalHealthWorkoutByPlatformRecordId:
SELECT * FROM local_health_workout WHERE platform_record_id = ? AND deleted = 0;

selectLocalHealthWorkoutsInRange:
SELECT * FROM local_health_workout
WHERE deleted = 0 AND start_at >= ? AND start_at < ?
ORDER BY start_at DESC;

selectAllLocalHealthWorkouts:
SELECT * FROM local_health_workout WHERE deleted = 0 ORDER BY start_at DESC;

upsertLocalHealthWorkout:
INSERT OR REPLACE INTO local_health_workout(
  id, sync_identifier, sync_version, activity_type, start_at, end_at,
  active_energy_kcal, basal_energy_kcal, distance_metres, steps,
  average_heart_rate_bpm, max_heart_rate_bpm, average_cadence_spm,
  plan_id, session_id, origin, source_bundle, source_name, platform_record_id,
  deleted, removed_from_platform, updated_at, notes
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

softDeleteLocalHealthWorkout:
UPDATE local_health_workout SET deleted = 1, updated_at = ? WHERE id = ?;

markLocalHealthWorkoutRemovedFromPlatform:
UPDATE local_health_workout SET removed_from_platform = 1, updated_at = ? WHERE id = ?;

clearLocalHealthWorkoutRemovedFromPlatform:
UPDATE local_health_workout SET removed_from_platform = 0, updated_at = ? WHERE id = ?;

linkLocalHealthWorkoutPlatformRecord:
UPDATE local_health_workout SET platform_record_id = ?, updated_at = ? WHERE id = ?;

selectSamplesForWorkout:
SELECT * FROM local_health_sample WHERE workout_id = ? ORDER BY recorded_at ASC;

deleteSamplesForWorkout:
DELETE FROM local_health_sample WHERE workout_id = ?;

insertLocalHealthSample:
INSERT OR REPLACE INTO local_health_sample(
  id, workout_id, sample_type, recorded_at, end_at, value, unit
) VALUES (?, ?, ?, ?, ?, ?, ?);

selectRouteForWorkout:
SELECT * FROM local_health_route_point WHERE workout_id = ? ORDER BY point_index ASC;

deleteRouteForWorkout:
DELETE FROM local_health_route_point WHERE workout_id = ?;

insertLocalHealthRoutePoint:
INSERT OR REPLACE INTO local_health_route_point(
  id, workout_id, recorded_at, latitude, longitude, altitude_metres, point_index
) VALUES (?, ?, ?, ?, ?, ?, ?);

selectEventsForWorkout:
SELECT * FROM local_health_event WHERE workout_id = ? ORDER BY event_index ASC;

deleteEventsForWorkout:
DELETE FROM local_health_event WHERE workout_id = ?;

insertLocalHealthEvent:
INSERT OR REPLACE INTO local_health_event(
  id, workout_id, event_type, start_at, end_at, label, event_index
) VALUES (?, ?, ?, ?, ?, ?, ?);

selectSetsForWorkout:
SELECT * FROM local_health_set WHERE workout_id = ? ORDER BY set_index ASC;

deleteSetsForWorkout:
DELETE FROM local_health_set WHERE workout_id = ?;

insertLocalHealthSet:
INSERT OR REPLACE INTO local_health_set(
  id, workout_id, exercise_key, set_index, reps, load_kg, duration_seconds, distance_metres, rir, rpe,
  is_warmup, is_drop_set, is_failure, note
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectHealthSyncState:
SELECT * FROM health_sync_state WHERE platform = ?;

upsertHealthSyncState:
INSERT OR REPLACE INTO health_sync_state(platform, change_token, last_sync_at, auth_status)
VALUES (?, ?, ?, ?);

selectOpenHealthConflicts:
SELECT * FROM health_conflict WHERE resolved = 0 ORDER BY created_at DESC;

selectConflictsForWorkout:
SELECT * FROM health_conflict WHERE workout_id = ? ORDER BY created_at DESC;

upsertHealthConflict:
INSERT OR REPLACE INTO health_conflict(
  id, workout_id, platform, field_name, local_value, platform_value, preferred_source, resolved, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

resolveHealthConflict:
UPDATE health_conflict SET resolved = 1 WHERE id = ?;
