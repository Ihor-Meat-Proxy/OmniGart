    "workouts_program_intro": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a full-body or split plan from your equipment. Coaching aid only — not medical advice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Складіть план на все тіло або спліт з наявного обладнання. Лише тренерська допомога — не медична порада."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ułóż plan całego ciała lub split z dostępnego sprzętu. To wskazówka treningowa, nie porada medyczna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Складзіце план на ўсё цела або спліт з наяўнага абсталявання. Толькі трэнерская дапамога — не медыцынская парада."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолдағы жабдықтан толық дене немесе сплит жоспарын жасаңыз. Тек жаттықтырушылық көмек — медициналық кеңес емес."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ააწყვეთ მთელი სხეულის ან სპლიტის გეგმა თქვენი აღჭურვილობით. მხოლოდ მწვრთნელის დახმარებაა — არა სამედიცინო რჩევა."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un plan de cuerpo completo o dividido con tu material. Solo ayuda de entrenamiento, no consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un plan full-body ou split selon votre matériel. Aide d’entraînement uniquement — pas un avis médical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie einen Ganzkörper- oder Split-Plan aus Ihrem Gerät. Nur Trainingshilfe — keine medizinische Beratung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sestavte celotělový nebo split plán podle vybavení. Jen tréninková pomůcka — ne lékařská rada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据现有器械生成全身或分化计划。仅供训练参考，不是医疗建议。"
          }
        }
      }
    },
