    "treadmill_run_title": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Treadmill run"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біг на доріжці"
          }
        },
        "pl": {
