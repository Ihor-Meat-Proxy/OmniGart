    "planner_scheme_replace_hint": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds guided strength, free strength, functional, runs, treadmill and Zone 2 days from your goals and equipment. Edits stay on-device."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будує силові (за планом / вільні / функціональні), біг, бігову доріжку та Zone 2 з ваших цілей і обладнання. Зміни лишаються на пристрої."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buduje siłę z planem, wolną i funkcjonalną, biegi, bieżnię i Zone 2 z celów i sprzętu. Edycje zostają na urządzeniu."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Будзе сілу па плане, вольную і функцыянальную, бег, бяговую дарожку і Zone 2 з мэтаў і абсталявання. Змены застаюцца на прыладзе."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсаттар мен жабдықтан жоспарлы/еркін/функционалдық күш, жүгіру, жүгіру жолы және Zone 2 жасайды. Өңдеулер құрылғыда қалады."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიზნებისა და აღჭურვილობიდან აგებს გეგმიურ/თავისუფალ/ფუნქციურ ძალას, სირბილს, სარბენს და Zone 2-ს. ცვლილებები მოწყობილობაზე რჩება."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea fuerza guiada, libre y funcional, carreras, cinta y Zone 2 según objetivos y equipo. Los cambios quedan en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée force guidée, libre et fonctionnelle, courses, tapis et Zone 2 selon objectifs et matériel. Les modifs restent sur l’appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt geführte, freie und Functional-Kraft, Läufe, Laufband und Zone 2 aus Zielen und Equipment. Änderungen bleiben auf dem Gerät."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sestaví řízenou, volnou a funkční sílu, běhy, pás a Zone 2 z cílů a vybavení. Úpravy zůstanou v zařízení."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据目标与器械生成引导力量、自由力量、功能性、跑步、跑步机与二区日。编辑仅留在设备上。"
          }
        }
      }
    },
