    "planner_suggest_reason_back_to_back": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday was hard — today’s hard plan could become easy Zone 2."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Учора було важко — сьогоднішній важкий план можна зробити легким Zone 2."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczoraj było ciężko — dzisiejszy ciężki plan może stać się łatwym Zone 2."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Учора было цяжка — сённяшні цяжкі план можна зрабіць лёгкім Zone 2."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кеше ауыр болды — бүгінгі ауыр жоспарды жеңіл Zone 2 ету алады."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გუშინ მძიმე იყო — დღევანდელი მძიმე გეგმა შეიძლება მსუბუქ Zone 2 გახდეს."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayer fue duro — el plan duro de hoy podría pasar a Zone 2 fácil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier était dur — le plan dur d’aujourd’hui pourrait devenir une Zone 2 facile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestern war hart — der heutige harte Plan könnte easy Zone 2 werden."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Včera bylo těžké — dnešní těžký plán by mohl být lehký Zone 2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天偏硬——今天的硬课可改为轻松二区。"
          }
        }
      }
    },
    "planner_suggest_reason_load_elevated": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent training load looks elevated versus your usual week."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нещодавнє навантаження виглядає підвищеним проти звичного тижня."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie obciążenie wygląda podwyższone względem zwykłego tygodnia."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нядаўняе нагружанне выглядае павышаным супраць звыклага тыдня."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы жүктеме әдеттегі аптамен салыстырғанда жоғары көрінеді."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო დატვირთვა ჩვეულ კვირასთან შედარებით მომატებულია."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga reciente parece elevada frente a tu semana habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge récente paraît élevée par rapport à votre semaine habituelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die jüngste Trainingslast wirkt gegenüber Ihrer üblichen Woche erhöht."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedávné zatížení vypadá vyšší než váš obvyklý týden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近期训练负荷相对平时偏高。"
          }
        }
      }
    },
    "planner_suggest_reason_muscle_recovery": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A recent session still overlaps these muscle groups — consider moving."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нещодавня сесія ще перекриває ці групи м’язів — варто перенести."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedawna sesja nadal obejmuje te grupy mięśni — rozważ przesunięcie."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нядаўняя сесія яшчэ перакрывае гэтыя групы мышцаў — варта перанесці."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жақындағы сессия әлі осы бұлшықет топтарын қамтиды — жылжытуды қарастырыңыз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო სესია ჯერ კიდევ ფარავს ამ კუნთების ჯგუფებს — განიხილეთ გადატანა."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión reciente aún solapa estos grupos musculares — valora moverla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une séance récente chevauche encore ces groupes musculaires — envisagez de décaler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kürzliche Einheit überschneidet diese Muskelgruppen noch — Verschieben erwägen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedávná jednotka stále překrývá tyto svalové skupiny — zvažte přesun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近期训练仍涉及这些肌群——可考虑改期。"
          }
        }
      }
    },
    "planner_suggest_reason_readiness_low": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Readiness is softer today — swap a hard session for easy Zone 2."
