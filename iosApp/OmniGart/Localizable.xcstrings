    "insights_tlr_sweet": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Near the soft sweet spot (about 0.8–1.3). A wellness guide only."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біля м’якої «золотої» зони (близько 0,8–1,3). Лише орієнтир добробуту."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blisko miękkiego sweet spotu (ok. 0,8–1,3). Tylko wskazówka wellness."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Каля мяккай «залатой» зоны (каля 0,8–1,3). Толькі арыенцір дабрабыту."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жұмсақ ыңғайлы аймаққа жақын (шамамен 0,8–1,3). Тек сауықтыру бағдары."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რბილ სასურველ ზონასთან ახლოს (დაახლ. 0.8–1.3). მხოლოდ კეთილდღეობის ორიენტირი."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de la zona suave (aprox. 0,8–1,3). Solo guía de bienestar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Près de la zone douce (environ 0,8–1,3). Guide bien-être uniquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahe am weichen Sweet Spot (etwa 0,8–1,3). Nur Wellness-Orientierung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blízko měkkému sweet spotu (asi 0,8–1,3). Jen wellness vodítko."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接近柔和适宜区间（约 0.8–1.3）。仅为健康参考。"
          }
        }
      }
    },
    "insights_tlr_low": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Below the soft band — recent load is lighter than your fitness base."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижче м’якої зони — недавнє навантаження легше за базу форми."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poniżej miękkiego zakresu — niedawne obciążenie jest lżejsze niż baza formy."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніжэй мяккай зоны — нядаўняя нагрузка лягчэйшая за базу формы."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жұмсақ жолақтан төмен — соңғы жүктеме форма негізіндегінен жеңіл."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რბილ ზოლზე ქვემოთ — ბოლოდროინდელი დატვირთვა ფორმის ბაზაზე მსუბუქია."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por debajo de la banda suave — la carga reciente es más ligera que tu base."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous la bande douce — la charge récente est plus légère que votre base."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dem weichen Band — die aktuelle Last ist leichter als Ihre Basis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod měkkým pásmem — nedávná zátěž je lehčí než základ formy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于柔和区间——近期负荷轻于体能基础。"
          }
        }
      }
    },
    "insights_tlr_elevated": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Above the soft band — recent load is higher than your fitness base."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вище м’якої зони — недавнє навантаження вище за базу форми."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powyżej miękkiego zakresu — niedawne obciążenie jest wyższe niż baza formy."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вышэй мяккай зоны — нядаўняя нагрузка вышэйшая за базу формы."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жұмсақ жолақтан жоғары — соңғы жүктеме форма негізіндегінен жоғары."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რბილ ზოლზე ზემოთ — ბოლოდროინდელი დატვირთვა ფორმის ბაზაზე მაღალია."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por encima de la banda suave — la carga reciente supera tu base."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-dessus de la bande douce — la charge récente dépasse votre base."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über dem weichen Band — die aktuelle Last liegt über Ihrer Basis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad měkkým pásmem — nedávná zátěž je vyšší než základ formy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高于柔和区间——近期负荷高于体能基础。"
          }
        }
      }
    },
    "insights_tlr_need_fitness": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a fitness base with a few weeks of training to see this ratio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наберіть базу форми за кілька тижнів тренувань, щоб побачити це співвідношення."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbuduj bazę formy przez kilka tygodni treningu, aby zobaczyć ten wskaźnik."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Набярыце базу формы за некалькі тыдняў трэніровак, каб убачыць гэтыя суадносіны."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы қатынасты көру үшін бірнеше апта жаттығып форма негізін жинаңыз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თანაფარდობის სანახავად რამდენიმე კვირის ვარჯიშით ააშენეთ ფორმის ბაზა."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una base de forma con unas semanas de entrenamiento para ver este ratio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construisez une base de forme sur quelques semaines pour voir ce ratio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bauen Sie mit einigen Trainingswochen eine Fitnessbasis auf, um dieses Verhältnis zu sehen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybudujte základ formy pár týdny tréninku, abyste viděli tento poměr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先训练数周建立体能基础后再查看此比值。"
          }
        }
      }
    },
