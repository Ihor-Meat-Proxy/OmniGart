CREATE TABLE local_health_workout (
  id TEXT NOT NULL PRIMARY KEY,
  sync_identifier TEXT NOT NULL,
  sync_version INTEGER NOT NULL DEFAULT 1,
  activity_type TEXT NOT NULL,
  start_at TEXT NOT NULL,
  end_at TEXT NOT NULL,
  active_energy_kcal REAL,
  basal_energy_kcal REAL,
  distance_metres REAL,
  steps INTEGER,
  average_heart_rate_bpm REAL,
  max_heart_rate_bpm REAL,
  average_cadence_spm REAL,
  plan_id TEXT,
  session_id TEXT,
  origin TEXT NOT NULL,
  source_bundle TEXT,
  source_name TEXT,
  platform_record_id TEXT,
  deleted INTEGER NOT NULL DEFAULT 0,
  updated_at TEXT NOT NULL,
  notes TEXT
);

CREATE TABLE local_health_sample (
  id TEXT NOT NULL PRIMARY KEY,
  workout_id TEXT NOT NULL,
  sample_type TEXT NOT NULL,
  recorded_at TEXT NOT NULL,
  end_at TEXT,
  value REAL NOT NULL,
  unit TEXT NOT NULL,
  FOREIGN KEY(workout_id) REFERENCES local_health_workout(id) ON DELETE CASCADE
);

CREATE TABLE local_health_route_point (
  id TEXT NOT NULL PRIMARY KEY,
  workout_id TEXT NOT NULL,
  recorded_at TEXT NOT NULL,
  latitude REAL NOT NULL,
  longitude REAL NOT NULL,
  altitude_metres REAL,
  point_index INTEGER NOT NULL,
  FOREIGN KEY(workout_id) REFERENCES local_health_workout(id) ON DELETE CASCADE
);

CREATE TABLE local_health_event (
  id TEXT NOT NULL PRIMARY KEY,
  workout_id TEXT NOT NULL,
  event_type TEXT NOT NULL,
  start_at TEXT NOT NULL,
  end_at TEXT,
  label TEXT,
  event_index INTEGER NOT NULL,
  FOREIGN KEY(workout_id) REFERENCES local_health_workout(id) ON DELETE CASCADE
);

CREATE TABLE local_health_set (
  id TEXT NOT NULL PRIMARY KEY,
  workout_id TEXT NOT NULL,
  exercise_key TEXT NOT NULL,
  set_index INTEGER NOT NULL,
  reps INTEGER,
  load_kg REAL,
  duration_seconds INTEGER,
  distance_metres REAL,
  rir REAL,
  is_warmup INTEGER NOT NULL DEFAULT 0,
  FOREIGN KEY(workout_id) REFERENCES local_health_workout(id) ON DELETE CASCADE
);

CREATE TABLE health_sync_state (
  platform TEXT NOT NULL PRIMARY KEY,
  change_token TEXT,
  last_sync_at TEXT,
  auth_status TEXT NOT NULL DEFAULT 'NOT_DETERMINED'
);

CREATE TABLE health_conflict (
  id TEXT NOT NULL PRIMARY KEY,
  workout_id TEXT NOT NULL,
  platform TEXT NOT NULL,
  field_name TEXT NOT NULL,
  local_value TEXT,
  platform_value TEXT,
  preferred_source TEXT NOT NULL,
  resolved INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL,
  FOREIGN KEY(workout_id) REFERENCES local_health_workout(id) ON DELETE CASCADE
);

CREATE INDEX local_health_workout_sync_idx ON local_health_workout(sync_identifier);
CREATE INDEX local_health_workout_start_idx ON local_health_workout(start_at);
CREATE INDEX local_health_sample_workout_idx ON local_health_sample(workout_id);
CREATE INDEX local_health_route_workout_idx ON local_health_route_point(workout_id);
CREATE INDEX health_conflict_open_idx ON health_conflict(resolved);
