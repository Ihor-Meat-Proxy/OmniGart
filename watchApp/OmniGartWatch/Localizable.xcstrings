    "planner_suggest_reason_recovery_signals": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV, resting heart rate or sleep suggest an easier day."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV, пульс спокою або сон підказують легший день."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV, tętno spoczynkowe lub sen sugerują łatwiejszy dzień."
          }
        },
        "be": {
