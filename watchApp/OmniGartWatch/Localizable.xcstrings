    "treadmill_calibration_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No treadmill link — enter the console distance (metres) to calibrate the watch estimate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає зв’язку з доріжкою — введіть дистанцію з консолі (метри), щоб відкалібрувати оцінку годинника."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia z bieżnią — wpisz dystans z konsoli (metry), by skalibrować szacunek zegarka."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма сувязі з дарожкай — увядзіце дыстанцыю з кансолі (метры), каб адкалібраваць ацэнку гадзінніка."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүгіру жолымен байланыс жоқ — сағат бағасын калибрлеу үшін консоль қашықтығын (метр) енгізіңіз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სარბენ ბილიკთან კავშირი არ არის — საათის შეფასების კალიბრაციისთვის შეიყვანეთ კონსოლის დისტანცია (მეტრი)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin enlace a la cinta — introduce la distancia de la consola (metros) para calibrar la estimación del reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de lien tapis — saisissez la distance console (mètres) pour calibrer l’estimation de la montre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Laufband-Link — Konsolen-Distanz (Meter) eingeben, um die Watch-Schätzung zu kalibrieren."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez spojení s pásem — zadejte vzdálenost z konzole (metry) pro kalibraci odhadu hodinek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接跑步机——输入控制台距离（米）以校准手表估算。"
          }
        }
      }
    },
