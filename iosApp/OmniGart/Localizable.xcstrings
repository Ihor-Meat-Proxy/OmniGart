    "data_privacy_intro": {
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart keeps a full local copy of your workouts and samples on this device. Export stays on-device. Platform sync is optional and never required for logging."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart зберігає повну локальну копію тренувань і зразків на цьому пристрої. Експорт лишається на пристрої. Синхронізація з платформою необов’язкова."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart przechowuje pełną lokalną kopię treningów i próbek na tym urządzeniu. Eksport pozostaje na urządzeniu. Synchronizacja z platformą jest opcjonalna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart захоўвае поўную лакальную копію трэніровак і ўзораў на гэтай прыладзе. Экспарт застаецца на прыладзе. Сінхранізацыя з платформай неабавязковая."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart жаттығулар мен үлгілердің толық жергілікті көшірмесін осы құрылғыда сақтайды. Экспорт құрылғыда қалады. Платформамен синхрондау міндетті емес."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart ინახავს ვარჯიშებისა და ნიმუშების სრულ ლოკალურ ასლს ამ მოწყობილობაზე. ექსპორტი რჩება მოწყობილობაზე. პლატფორმასთან სინქრონიზაცია არასავალდებულოა."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart guarda una copia local completa de tus entrenamientos y muestras en este dispositivo. La exportación permanece en el dispositivo. La sincronización es opcional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart conserve une copie locale complète de vos séances et échantillons sur cet appareil. L’export reste sur l’appareil. La synchronisation est facultative."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart speichert eine vollständige lokale Kopie Ihrer Workouts und Messwerte auf diesem Gerät. Der Export bleibt auf dem Gerät. Die Synchronisierung ist optional."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart uchovává úplnou místní kopii tréninků a vzorků na tomto zařízení. Export zůstává v zařízení. Synchronizace s platformou je volitelná."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart 会在本机保存训练与采样的完整本地副本。导出仅留在本机。平台同步为可选，记录训练无需授权。"
          }
        }
      }
    },
