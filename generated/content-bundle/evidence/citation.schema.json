{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnigart.dev/schemas/citation.schema.json",
  "title": "OmniGartEvidenceCitation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "authors", "year", "type"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable citation key, e.g. mifflin_st_jeor_1990",
      "pattern": "^[a-z0-9_]+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
    "type": {
      "type": "string",
      "enum": ["journal", "book", "guideline", "report", "other"]
    },
    "journal": { "type": "string" },
    "volume": { "type": "string" },
    "issue": { "type": "string" },
    "pages": { "type": "string" },
    "doi": { "type": "string" },
    "pmid": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "notes": { "type": "string" },
    "usedBy": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Module or formula identifiers that cite this source"
    }
  }
}
