{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnigart.dev/schemas/achievement.schema.json",
  "title": "OmniGartAchievement",
  "description": "Data-driven achievement definition with declarative rule DSL.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "type",
    "tiers",
    "rule",
    "iconId",
    "hidden",
    "repeatable",
    "titleKey",
    "descriptionKey"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9_]+)+$",
      "minLength": 5,
      "maxLength": 96,
      "description": "Stable dotted id, e.g. strength.first_workout"
    },
    "category": {
      "type": "string",
      "enum": [
        "strength",
        "running",
        "swimming",
        "yoga",
        "pilates",
        "nutrition",
        "water",
        "recovery",
        "body",
        "general"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "streak",
        "milestone",
        "single_session",
        "personal_record",
        "challenge",
        "discovery"
      ]
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/tier" }
    },
    "rule": { "$ref": "#/$defs/rule" },
    "iconId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Icon name from design/icons or content/achievements/proposed-icons.json"
    },
    "hidden": {
      "type": "boolean",
      "description": "Secret until unlocked; UI shows a placeholder"
    },
    "repeatable": {
      "type": "boolean",
      "description": "If true, can unlock again after reset (e.g. monthly challenges)"
    },
    "titleKey": {
      "type": "string",
      "pattern": "^achievement\\.[a-z0-9_.]+\\.title$"
    },
    "descriptionKey": {
      "type": "string",
      "pattern": "^achievement\\.[a-z0-9_.]+\\.description$"
    },
    "healthyNotes": {
      "type": "string",
      "description": "Optional design rationale for healthy-behaviour constraints"
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "threshold"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["bronze", "silver", "gold", "platinum", "level_1", "level_2", "level_3", "level_4", "level_5", "unlocked"]
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "titleKeySuffix": {
          "type": "string",
          "description": "Optional override suffix; default uses tier id"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "aggregation", "window"],
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "workouts_completed",
            "sets_logged",
            "volume_kg",
            "session_duration_min",
            "distance_m",
            "pace_sec_per_km",
            "swim_strokes_distinct",
            "yoga_minutes",
            "pilates_minutes",
            "food_days_logged",
            "water_goal_days",
            "sleep_consistent_days",
            "measurements_logged",
            "measurement_days",
            "personal_record_events",
            "disciplines_tried",
            "planned_rest_honoured",
            "freeze_tokens_used",
            "challenge_points"
          ]
        },
        "aggregation": {
          "type": "string",
          "enum": ["count", "sum", "max", "min", "distinct", "streak", "exists"]
        },
        "window": { "$ref": "#/$defs/window" },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Base threshold when tiers are not used for scaling; tiers.threshold override when present"
        },
        "filters": { "$ref": "#/$defs/filters" },
        "compare": {
          "type": "string",
          "enum": ["gte", "lte", "eq"],
          "default": "gte"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "lifetime",
            "rolling_days",
            "calendar",
            "single_event",
            "challenge_period",
            "streak_days"
          ]
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3660
        },
        "unit": {
          "type": "string",
          "enum": ["day", "week", "month"]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "period": {
          "type": "string",
          "enum": ["current_month", "current_week", "explicit"]
        },
        "startDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "qualify": {
          "type": "string",
          "enum": [
            "activity",
            "log",
            "goal_met",
            "activity_or_planned_rest"
          ],
          "description": "What counts as a qualifying day for streak_days windows"
        },
        "restDayTolerancePerWeek": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "Extra unplanned rest days that do not break a streak (beyond planned rest)"
        },
        "freezeTokensAllowed": {
          "type": "boolean",
          "description": "Whether freeze tokens may preserve the streak across a miss"
        },
        "maxFreezePerStreak": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "rolling_days" } } },
          "then": { "required": ["days"] }
        },
        {
          "if": { "properties": { "kind": { "const": "calendar" } } },
          "then": { "required": ["unit"] }
        },
        {
          "if": { "properties": { "kind": { "const": "streak_days" } } },
          "then": { "required": ["qualify"] }
        },
        {
          "if": { "properties": { "kind": { "const": "challenge_period" } } },
          "then": { "required": ["period"] }
        }
      ]
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discipline": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["strength", "running", "swimming", "yoga", "pilates", "mobility", "other"]
          },
          "uniqueItems": true
        },
        "minDurationMin": { "type": "number", "minimum": 0 },
        "minDistanceM": { "type": "number", "minimum": 0 },
        "maxDistanceM": { "type": "number", "minimum": 0 },
        "stroke": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["freestyle", "backstroke", "breaststroke", "butterfly", "drill"]
          }
        },
        "measurementKind": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["weight", "girth", "body_fat", "other"]
          }
        },
        "waterGoalMl": { "type": "integer", "minimum": 1 },
        "sleepMidpointVarianceMin": {
          "type": "number",
          "minimum": 0,
          "description": "Max allowed midpoint variance (minutes) to count as consistent sleep"
        },
        "excludeCaloriesBelow": {
          "type": "integer",
          "minimum": 0,
          "description": "Safety: never award based on intake below this; catalogue must omit calorie-restriction metrics"
        },
        "excludeWeightLossRate": {
          "type": "boolean",
          "description": "Safety: body achievements must not use weight-loss speed"
        }
      }
    }
  }
}
