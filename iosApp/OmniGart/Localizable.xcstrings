    "perm_explainer_bluetooth_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a heart-rate or similar fitness accessory for live samples. OmniGart works fully without Bluetooth."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть пульсометр або подібний фітнес-аксесуар для живих зразків. OmniGart повністю працює без Bluetooth."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłącz pulsometr lub podobne akcesorium fitness do żywych próbek. OmniGart działa w pełni bez Bluetooth."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падключыце пульсаметр або падобны фітнес-аксэсуар для жывых узораў. OmniGart цалкам працуе без Bluetooth."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тірі үлгілер үшін жүрек соғу немесе ұқсас фитнес аксессуарын қосыңыз. OmniGart Bluetoothсыз толық жұмыс істейді."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაუკავშირეთ გულისცემის ან მსგავსი ფიტნეს აქსესუარი ცოცხალი ნიმუშებისთვის. OmniGart სრულად მუშაობს Bluetooth-ის გარეშე."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta un monitor de frecuencia cardíaca o un accesorio de fitness similar para muestras en vivo. OmniGart funciona por completo sin Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un moniteur de fréquence cardiaque ou un accessoire fitness similaire pour des échantillons en direct. OmniGart fonctionne pleinement sans Bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie einen Herzfrequenzmesser oder ähnliches Fitness-Zubehör für Live-Proben. OmniGart funktioniert vollständig ohne Bluetooth."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte tepoměr nebo podobné fitness příslušenství pro živé vzorky. OmniGart plně funguje bez Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接心率或其他健身配件以获取实时样本。OmniGart 在无蓝牙时也可完整使用。"
          }
        }
      }
    },
