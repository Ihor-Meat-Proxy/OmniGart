    "shell_intro": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellness estimates from your shared OmniGart profile"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінки самопочуття з вашого спільного профілю OmniGart"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunki wellness z Twojego wspólnego profilu OmniGart"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ацэнкі самаадчування з вашага агульнага профілю OmniGart"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ортақ OmniGart профиліңізден алынған сауықтыру бағалаулары"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კეთილდღეობის შეფასებები თქვენი საერთო OmniGart პროფილიდან"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimaciones de bienestar desde tu perfil compartido de OmniGart"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimations de bien-être depuis votre profil OmniGart partagé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellness-Schätzungen aus Ihrem gemeinsamen OmniGart-Profil"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellness odhady z vašeho sdíleného profilu OmniGart"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自共享 OmniGart 个人资料的健康估算"
          }
        }
      }
    },
    "wellness_disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart provides wellness estimates only. Readiness, stress, HRV, Baevsky index, body-fat estimates, hydration targets, and training plans are not medical advice. Consult a qualified professional for health concerns."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart надає лише оцінки самопочуття. Готовність, стрес, ВСР, індекс Баєвського, оцінка жиру в тілі, цілі гідратації та плани тренувань не є медичною консультацією. Звертайтеся до кваліфікованого фахівця щодо питань здоров’я."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart dostarcza wyłącznie szacunki wellness. Gotowość, stres, HRV, indeks Bajewskiego, szacunki tkanki tłuszczowej, cele nawodnienia i plany treningowe nie są poradą medyczną. W sprawach zdrowia skonsultuj się z wykwalifikowanym specjalistą."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart дае толькі ацэнкі самаадчування. Гатоўнасць, стрэс, ВСР, індэкс Баеўскага, ацэнкі тлушчу ў целе, мэты гідратацыі і планы трэніровак не з’яўляюцца медыцынскай кансультацыяй. Звяртайцеся да кваліфікаванага спецыяліста па пытаннях здароўя."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart тек сауықтыру бағалауларын береді. Дайындық, стресс, ЖЖВ, Баевский индексі, дене майы бағалаулары, су ішу мақсаттары және жаттығу жоспарлары медициналық кеңес емес. Денсаулық мәселелері бойынша білікті маманға жүгініңіз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart იძლევა მხოლოდ კეთილდღეობის შეფასებებს. მზადყოფნა, სტრესი, HRV, ბაევსკის ინდექსი, სხეულის ცხიმის შეფასებები, ჰიდრატაციის მიზნები და ვარჯიშის გეგმები არ არის სამედიცინო რჩევა. ჯანმრთელობის საკითხებზე მიმართეთ კვალიფიციურ სპეციალისტს."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart ofrece solo estimaciones de bienestar. La preparación, el estrés, la VFC, el índice de Baevsky, las estimaciones de grasa corporal, los objetivos de hidratación y los planes de entrenamiento no son consejo médico. Consulta a un profesional cualificado ante dudas de salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart fournit uniquement des estimations de bien-être. La préparation, le stress, la VRC, l’indice de Baevsky, les estimations de masse grasse, les objectifs d’hydratation et les plans d’entraînement ne constituent pas un avis médical. Consultez un professionnel qualifié pour toute question de santé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart liefert ausschließlich Wellness-Schätzungen. Bereitschaft, Stress, HRV, Baevsky-Index, Körperfett-Schätzungen, Hydrationsziele und Trainingspläne sind keine medizinische Beratung. Bei Gesundheitsfragen wenden Sie sich an eine qualifizierte Fachkraft."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart poskytuje pouze wellness odhady. Připravenost, stres, HRV, Bajevského index, odhady tělesného tuku, cíle hydratace a tréninkové plány nejsou lékařskou radou. V otázkách zdraví se obraťte na kvalifikovaného odborníka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OmniGart 仅提供健康估算。准备度、压力、心率变异、Baevsky 指数、体脂估算、补水目标和训练计划均非医疗建议。如有健康顾虑，请咨询合格专业人士。"
          }
        }
      }
    },
    "info_sheet_not_medical_advice": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not medical advice. Consult a professional."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не медична консультація. Зверніться до фахівця."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest porada medyczna. Skonsultuj się ze specjalistą."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта не медыцынская кансультацыя. Звярніцеся да спецыяліста."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл медициналық кеңес емес. Маманға жүгініңіз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს არ არის სამედიცინო რჩევა. მიმართეთ სპეციალისტს."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es consejo médico. Consulta a un profesional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci n’est pas un avis médical. Consultez un professionnel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine medizinische Beratung. Konsultieren Sie eine Fachkraft."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejde o lékařskou radu. Obraťte se na odborníka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非医疗建议。请咨询专业人士。"
          }
        }
      }
    },
    "health_warning_chest_pain": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop and seek emergency help if you feel chest pain, severe dizziness, or unusual shortness of breath during activity."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиніться і зверніться по екстрену допомогу, якщо під час активності відчуваєте біль у грудях, сильне запаморочення або незвичну задишку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj się i wezwij pomoc w nagłych wypadkach, jeśli podczas aktywności odczuwasz ból w klatce piersiowej, silne zawroty głowy lub nietypową duszność."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спыніцеся і звярніцеся па экстраную дапамогу, калі падчас актыўнасці адчуваеце боль у грудзях, моцнае галавакружэнне або незвычайную дыхавіцу."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белсенділік кезінде кеуде ауруы, қатты бас айналу немесе әдеттен тыс тыныс тарылуын сезсеңіз, тоқтап, жедел жәрдемге жүгініңіз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეწყვიტეთ და მიმართეთ გადაუდებელ დახმარებას, თუ აქტივობისას გრძნობთ გულმკერდის ტკივილს, ძლიერ თავბრუსხვევას ან უჩვეულო სუნთქვის გაძნელებას."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detente y busca ayuda de emergencia si sientes dolor en el pecho, mareo intenso o falta de aire inusual durante la actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez-vous et demandez une aide d’urgence si vous ressentez une douleur thoracique, des vertiges sévères ou un essoufflement inhabituel pendant l’activité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen Sie und suchen Sie Notfallhilfe, wenn Sie während der Aktivität Brustschmerzen, starken Schwindel oder ungewöhnliche Atemnot spüren."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavte se a vyhledejte pohotovostní pomoc, pokud při aktivitě cítíte bolest na hrudi, silné závratě nebo neobvyklou dušnost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动期间如感到胸痛、严重眩晕或异常气短，请立即停止并寻求紧急救助。"
          }
        }
      }
    },
