{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnigart.dev/schemas/running-workout-type.schema.json",
  "title": "OmniGartRunningWorkoutType",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nameKeys",
    "category",
    "level",
    "durationMinutes",
    "structure",
    "intensityTargets",
    "cues",
    "evidenceRefs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80
    },
    "nameKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enGB", "uk"],
      "properties": {
        "enGB": { "type": "string", "pattern": "^running\\.workout\\.[a-z0-9_]+\\.name$" },
        "uk": { "type": "string", "pattern": "^running\\.workout\\.[a-z0-9_]+\\.name$" }
      }
    },
    "category": {
      "type": "string",
      "enum": ["easy", "tempo", "intervals", "fartlek", "long", "hill", "strides"]
    },
    "level": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "durationMinutes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typical"],
      "properties": {
        "typical": { "type": "integer", "minimum": 10, "maximum": 240 },
        "min": { "type": "integer", "minimum": 5, "maximum": 240 },
        "max": { "type": "integer", "minimum": 10, "maximum": 300 }
      }
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "descriptionKey"],
        "properties": {
          "phase": {
            "type": "string",
            "enum": ["warmup", "main", "recovery", "cooldown", "strides"]
          },
          "descriptionKey": {
            "type": "string",
            "pattern": "^running\\.workout\\.[a-z0-9_]+\\.structure\\.[a-z0-9_]+$"
          },
          "repeat": { "type": "integer", "minimum": 1, "maximum": 40 }
        }
      }
    },
    "intensityTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hrZones", "paceZones", "primaryLabel"],
      "properties": {
        "hrZones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["z1", "z2", "z3", "z4", "z5"]
          },
          "uniqueItems": true
        },
        "paceZones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["easy", "marathon", "threshold", "interval", "repetition"]
          },
          "uniqueItems": true
        },
        "primaryLabel": {
          "type": "string",
          "enum": ["easy", "marathon", "threshold", "interval", "repetition", "mixed"]
        },
        "rpeRange": {
          "type": "string",
          "pattern": "^[0-9]+(-[0-9]+)?$"
        }
      }
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8, "maxLength": 240 }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "label", "supports"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["doi", "pmid", "guideline", "textbook"]
          },
          "id": { "type": "string", "minLength": 3 },
          "label": { "type": "string", "minLength": 3 },
          "supports": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "notes": { "type": "string", "maxLength": 500 }
  }
}
