    "treadmill_walk_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Indoor walk with or without a Bluetooth treadmill. Pace and distance come from the machine when linked, otherwise from watch or phone motion — calibrate after if needed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кімнатна ходьба з Bluetooth-доріжкою або без неї. Темп і дистанція з машини, інакше з годинника чи телефону — можна відкалібрувати."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chód indoor z bieżnią Bluetooth lub bez. Tempo i dystans z urządzenia albo z zegarka/telefonu — możesz skalibrować później."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадзьба ў памяшканні з Bluetooth-дарожкай або без. Тэмп і дыстанцыя з машыны, інакш з гадзінніка ці тэлефона — можна адкалібраваць."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth жүгіру жолымен немесе онсыз ішкі жүру. Қадам мен қашықтық құрылғыдан, әйтпесе сағат/телефоннан — кейін калибрлеуге болады."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შიდა სიარული Bluetooth სარბენი ბილიკით ან მის გარეშე. ტემპი და დისტანცია აპარატიდან, სხვა შემთხვევაში საათიდან ან ტელეფონიდან — შემდეგ შეგიძლიათ დააკალიბროთ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminata indoor con o sin cinta Bluetooth. Ritmo y distancia de la máquina o del reloj/teléfono; puedes calibrar después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marche indoor avec ou sans tapis Bluetooth. Allure et distance viennent de la machine, sinon de la montre ou du téléphone — calibrage possible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indoor-Gehen mit oder ohne Bluetooth-Laufband. Tempo und Distanz vom Gerät, sonst von Watch oder Phone — danach kalibrierbar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chůze indoor s Bluetooth pásem nebo bez. Tempo a vzdálenost ze stroje, jinak z hodinek nebo telefonu — lze kalibrovat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在有或无蓝牙跑步机时进行室内步行。配速与距离来自器械，否则来自手表或手机运动估算，结束后可校准。"
          }
        }
      }
    },
