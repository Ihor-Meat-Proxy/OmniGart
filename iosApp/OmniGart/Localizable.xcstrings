      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Health data stays on your devices. OmniGart never sells it or uses it for advertising."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані здоров’я залишаються на ваших пристроях. OmniGart ніколи не продає їх і не використовує для реклами."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane zdrowotne zostają na Twoich urządzeniach. OmniGart ich nie sprzedaje ani nie używa do reklam."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадзеныя здароўя застаюцца на вашых прыладах. OmniGart ніколі не прадае іх і не выкарыстоўвае для рэкламы."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Денсаулық деректері құрылғыларыңызда қалады. OmniGart оларды сатпайды және жарнамаға пайдаланбайды."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯანმრთელობის მონაცემები რჩება თქვენს მოწყობილობებზე. OmniGart არ ყიდის და არ იყენებს რეკლამისთვის."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de salud permanecen en tus dispositivos. OmniGart no los vende ni los usa para publicidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de santé restent sur vos appareils. OmniGart ne les vend pas et ne les utilise pas pour la publicité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesundheitsdaten bleiben auf Ihren Geräten. OmniGart verkauft sie nicht und nutzt sie nicht für Werbung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdravotní data zůstávají na vašich zařízeních. OmniGart je neprodává ani nepoužívá k reklamě."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康数据保留在您的设备上。OmniGart 不会出售或将其用于广告。"
          }
        }
      }
    },
    "food_intro": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Log meals offline. Daily totals are wellness coaching aids, not medical advice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте їжу офлайн. Денні підсумки — тренерські оцінки, не медична консультація."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj posiłki offline. Dzienne sumy to wskazówki wellness, nie porada medyczna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запісвайце ежу афлайн. Дзённыя вынікі — трэнерскія ацэнкі, не медыцынская кансультацыя."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тамақты офлайн жазыңыз. Күнделікті қорытындылар — сауықтыру кеңестері, медициналық кеңес емес."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩაიწერეთ საკვები ოფლაინ. დღიური ჯამები კეთილდღეობის რჩევაა, არა სამედიცინო კონსულტაცია."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra comidas sin conexión. Los totales diarios son ayudas de bienestar, no consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les repas hors ligne. Les totaux du jour sont des aides bien-être, pas un avis médical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahlzeiten offline erfassen. Tageswerte sind Wellness-Hilfen, keine medizinische Beratung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenávejte jídlo offline. Denní součty jsou wellness pomůcky, ne lékařská rada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线记录餐食。每日合计为健康教练参考，不是医疗建议。"
          }
        }
      }
    },
