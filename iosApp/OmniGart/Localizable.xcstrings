    "nutrition_reason_rough_bmr": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Height or age missing — showing a rough estimate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає зросту чи віку — показано грубу оцінку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wzrostu lub wieku — pokazano przybliżony szacunek."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма росту ці ўзросту — паказана грубая ацэнка."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бой немесе жас жоқ — шамамен бағалау көрсетілді."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სიმაღლე ან ასაკი აკლია — ნაჩვენებია მიახლოებითი შეფასება."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta altura o edad: se muestra una estimación aproximada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille ou âge manquant — estimation approximative."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe oder Alter fehlt — grobe Schätzung."
          }
        },
        "cs": {
