    "programme.fb_beg_home.description": {
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Three home sessions for newcomers."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткий план для цього рівня та місця. Лише тренувальна підказка."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótki plan dla tego poziomu i miejsca. Tylko wskazówka treningowa."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кароткі план для гэтага ўзроўню і месца. Толькі трэніровачная падказка."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы деңгей мен орынға арналған қысқа жоспар. Тек жаттығу кеңесі."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოკლე გეგმა ამ დონისა და ადგილისთვის. მხოლოდ სავარჯიშო მინიშნება."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan breve para este nivel y lugar. Solo orientación de entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan court pour ce niveau et ce lieu. Aide à l’entraînement uniquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzer Plan für dieses Niveau und diesen Ort. Nur Trainingshilfe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátký plán pro tuto úroveň a místo. Pouze tréninková nápověda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合该水平与场地的简明计划。仅供训练参考。"
          }
        }
      }
    },
