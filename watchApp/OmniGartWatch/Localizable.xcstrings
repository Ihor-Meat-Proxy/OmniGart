    "planner_intro": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan workouts on-device: calendar, weekly scheme, and adaptive suggestions. Health data is never deleted."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плануйте тренування на пристрої: календар, тижнева схема та адаптивні підказки. Дані Health ніколи не видаляються."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Planuj treningi na urządzeniu: kalendarz, tygodniowy schemat i adaptacyjne podpowiedzi. Dane Health nigdy nie są usuwane."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плануйце трэніроўкі на прыладзе: каляндар, тыднёвая схема і адаптыўныя падказкі. Даныя Health ніколі не выдаляюцца."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаттығуларды құрылғыда жоспарлаңыз: күнтізбе, апталық схема және бейімделгіш ұсыныстар. Health деректері ешқашан жойылмайды."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაგეგმეთ ვარჯიშები მოწყობილობაზე: კალენდარი, ყოველკვირეული სქემა და ადაპტური რჩევები. Health მონაცემები არასდროს იშლება."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
