    "treadmill_saved": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Treadmill run saved locally and to Apple Health / Health Connect when allowed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біг на доріжці збережено локально та в Apple Health / Health Connect за дозволом."
          }
        },
        "pl": {
          "stringUnit": {
