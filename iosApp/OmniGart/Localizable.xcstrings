    "explore_programmes_intro": {
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-week plans for home or gym. Coaching aid only — not medical advice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бага тижневі плани для дому чи залу. Лише тренерська допомога — не медична порада."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plany wielotygodniowe na dom lub siłownię. Wskazówka treningowa, nie porada medyczna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Шматтыднёвыя планы для дома ці залы. Толькі трэнерская дапамога — не медыцынская парада."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үй немесе залға арналған көп апталық жоспарлар. Тек жаттықтырушылық көмек — медициналық кеңес емес."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მრავალკვირიანი გეგმები სახლისთვის ან დარბაზისთვის. მხოლოდ მწვრთნელის დახმარებაა — არა სამედიცინო რჩევა."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planes de varias semanas para casa o gimnasio. Solo ayuda de entrenamiento, no consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans sur plusieurs semaines pour la maison ou la salle. Aide d’entraînement uniquement — pas un avis médical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrwöchige Pläne für Zuhause oder Fitnessstudio. Nur Trainingshilfe — keine medizinische Beratung."
          }
        },
        "cs": {
          "stringUnit": {
