    "workouts_zone2_flag_off": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkoutKit scheduling is off in this build. You can still train with the in-app watch Zone 2 session when available."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Планування WorkoutKit у цій збірці вимкнено. Можна тренуватися з сесією зони 2 на годиннику, коли вона доступна."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Planowanie WorkoutKit jest wyłączone w tej kompilacji. Nadal możesz trenować sesją strefy 2 na zegarku, gdy będzie dostępna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Планаванне WorkoutKit у гэтай зборцы выключана. Можна трэніравацца з сесіяй зоны 2 на гадзінніку, калі яна даступная."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл құрастыруда WorkoutKit жоспарлау өшірулі. Қолжетімді болса, сағаттағы 2-аймақ сессиясымен жаттыға аласыз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ აგებაში WorkoutKit დაგეგმვა გამორთულია. ხელმისაწვდომობისას შეგიძლიათ საათის ზონა 2 სესიით ივარჯიშოთ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La programación de WorkoutKit está desactivada en esta versión. Aún puedes entrenar con la sesión Zone 2 del reloj cuando esté disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La planification WorkoutKit est désactivée dans cette version. Vous pouvez toujours vous entraîner avec la session Zone 2 de la montre lorsqu’elle est disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkoutKit-Planung ist in diesem Build aus. Sie können weiterhin mit der Zone-2-Session auf der Watch trainieren, wenn verfügbar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plánování WorkoutKit je v tomto sestavení vypnuté. Stále můžete trénovat sezónou zóny 2 na hodinkách, až bude dostupná."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建中未启用 WorkoutKit 排程。手表上的二区会话可用时仍可训练。"
          }
        }
      }
    },
    "recovery_intro": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellness recovery estimates from your profile and recent inputs. Not medical advice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінки відновлення самопочуття з вашого профілю та недавніх даних. Не медична консультація."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunki regeneracji wellness z profilu i ostatnich danych. To nie porada medyczna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ацэнкі аднаўлення самаадчування з профілю і нядаўніх дадзеных. Не медыцынская кансультацыя."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль мен соңғы деректерден сауықтыру қалпына келу бағалаулары. Медициналық кеңес емес."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კეთილდღეობის აღდგენის შეფასებები პროფილიდან და ბოლო მონაცემებიდან. სამედიცინო რჩევა არ არის."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimaciones de recuperación de bienestar desde tu perfil y entradas recientes. No es consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimations de récupération bien-être à partir de votre profil et des entrées récentes. Pas un avis médical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellness-Erholungsschätzungen aus Profil und jüngsten Eingaben. Keine medizinische Beratung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellness odhady regenerace z profilu a nedávných vstupů. Nejde o lékařskou radu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据个人资料与近期输入得出的恢复健康估算。不是医疗建议。"
          }
        }
      }
    },
