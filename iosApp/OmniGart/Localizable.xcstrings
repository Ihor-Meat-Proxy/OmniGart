    "workouts_zone2_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Start an easy Zone 2 continuous run for wellness aerobic work. Heart-rate bands are coaching estimates."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть легкий безперервний біг у зоні 2 для аеробної роботи. Зони пульсу — тренерські оцінки."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij łatwy ciągły bieg w strefie 2 dla pracy tlenowej. Strefy tętna to szacunki coachingowe."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пачніце лёгкі бесперапынны бег у зоне 2 для аэробнай працы. Зоны пульсу — трэнерскія ацэнкі."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аэробтық жұмыс үшін жеңіл 2-аймақ жүгіруін бастаңыз. Жүрек соғу аймақтары — жаттықтырушы бағалаулары."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაიწყეთ მსუბუქი ზონა 2 უწყვეტი სირბილი აერობული სამუშაოსთვის. გულისცემის ზონები მწვრთნელის შეფასებებია."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una carrera continua fácil en zona 2 para trabajo aeróbico. Las bandas de FC son estimaciones de coaching."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez une course continue facile en zone 2 pour le travail aérobie. Les zones FC sont des estimations d’entraînement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie einen leichten Zone-2-Dauerlauf für aerobes Wellness-Training. HF-Zonen sind Coaching-Schätzungen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spusťte snadný souvislý běh v zóně 2 pro aerobní práci. Tepové zóny jsou trenérské odhady."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始轻松的二区持续跑，作为有氧健康训练。心率区间为教练估算。"
          }
        }
      }
    },
