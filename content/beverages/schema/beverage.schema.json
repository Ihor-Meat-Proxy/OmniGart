{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnigart.dev/schemas/beverage.schema.json",
  "title": "OmniGartBeverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nameKeys",
    "category",
    "defaultServingMl",
    "caffeineMgPerServing",
    "macrosPer100ml",
    "hydrationFactor",
    "hydrationFactorEstimated",
    "evidenceRefs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 80
    },
    "nameKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enGB", "uk"],
      "properties": {
        "enGB": { "type": "string", "pattern": "^beverage\\.[a-z0-9_]+\\.name$" },
        "uk": { "type": "string", "pattern": "^beverage\\.[a-z0-9_]+\\.name$" }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "water",
        "sparkling_water",
        "coffee",
        "tea",
        "milk",
        "plant_milk",
        "juice",
        "soft_drink",
        "sports_drink",
        "fermented_dairy",
        "beer",
        "wine"
      ]
    },
    "defaultServingMl": { "type": "integer", "minimum": 1, "maximum": 2000 },
    "caffeineMgPerServing": { "type": "number", "minimum": 0, "maximum": 500 },
    "macrosPer100ml": {
      "type": "object",
      "additionalProperties": false,
      "required": ["energyKcal", "proteinG", "carbohydrateG", "fatG"],
      "properties": {
        "energyKcal": { "type": "number", "minimum": 0 },
        "proteinG": { "type": "number", "minimum": 0 },
        "carbohydrateG": { "type": "number", "minimum": 0 },
        "fatG": { "type": "number", "minimum": 0 },
        "sugarsG": { "type": "number", "minimum": 0 },
        "sodiumMg": { "type": "number", "minimum": 0 }
      }
    },
    "hydrationFactor": { "type": "number", "minimum": 0, "maximum": 3 },
    "hydrationFactorEstimated": { "type": "boolean" },
    "notes": { "type": "string", "maxLength": 500 },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "label", "supports"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["doi", "database", "textbook", "guideline"]
          },
          "id": { "type": "string", "minLength": 3 },
          "label": { "type": "string", "minLength": 3 },
          "supports": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
