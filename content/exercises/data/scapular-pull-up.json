  "technique": [
    "From a passive hang, depress and slightly retract the scapulae to lift the body a few centimetres without bending the elbows, then return to a passive hang."
  ],
  "setup": [
    "Pronated or neutral grip; think “pockets” for the scapulae."
  ],
  "breathing": "Exhale on the depression.",
  "commonMistakes": [
    "Bending the elbows into a mini pull-up",
    "Only shrugging the neck"
  ],
  "safety": [
    "Excellent primer; stop with sharp shoulder pain in the hang."
  ],
  "contraindications": [
    "Acute shoulder injury"
  ],
