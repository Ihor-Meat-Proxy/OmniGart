CREATE TABLE user_profile (
  id TEXT NOT NULL PRIMARY KEY,
  biological_sex TEXT NOT NULL,
  height_cm REAL NOT NULL,
  weight_kg REAL NOT NULL,
  date_of_birth TEXT NOT NULL,
  preferred_units TEXT NOT NULL,
  waist_cm REAL,
  hip_cm REAL
);

CREATE TABLE exercise (
  id TEXT NOT NULL PRIMARY KEY,
  content_key TEXT NOT NULL,
  modality TEXT NOT NULL,
  primary_muscles TEXT NOT NULL DEFAULT ''
);

CREATE TABLE workout (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  notes TEXT,
  exercise_ids TEXT NOT NULL DEFAULT ''
);

CREATE TABLE session (
  id TEXT NOT NULL PRIMARY KEY,
  workout_id TEXT,
  started_at TEXT NOT NULL,
  ended_at TEXT,
  perceived_exertion INTEGER,
  notes TEXT
);

CREATE TABLE workout_set (
  id TEXT NOT NULL PRIMARY KEY,
  session_id TEXT NOT NULL,
  exercise_id TEXT NOT NULL,
  set_index INTEGER NOT NULL,
  reps INTEGER,
  weight_kg REAL,
  duration_seconds INTEGER,
  distance_metres REAL,
  rir REAL,
  completed INTEGER NOT NULL DEFAULT 1,
  FOREIGN KEY(session_id) REFERENCES session(id) ON DELETE CASCADE
);

selectProfile:
SELECT * FROM user_profile WHERE id = ?;

selectAllProfiles:
SELECT * FROM user_profile;

upsertProfile:
INSERT OR REPLACE INTO user_profile(
  id, biological_sex, height_cm, weight_kg, date_of_birth, preferred_units, waist_cm, hip_cm
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteProfile:
DELETE FROM user_profile WHERE id = ?;

selectExercise:
SELECT * FROM exercise WHERE id = ?;

selectAllExercises:
SELECT * FROM exercise;

upsertExercise:
INSERT OR REPLACE INTO exercise(id, content_key, modality, primary_muscles)
VALUES (?, ?, ?, ?);

selectWorkout:
SELECT * FROM workout WHERE id = ?;

selectAllWorkouts:
SELECT * FROM workout;

upsertWorkout:
INSERT OR REPLACE INTO workout(id, name, notes, exercise_ids)
VALUES (?, ?, ?, ?);

selectSession:
SELECT * FROM session WHERE id = ?;

selectAllSessions:
SELECT * FROM session ORDER BY started_at DESC;

upsertSession:
INSERT OR REPLACE INTO session(id, workout_id, started_at, ended_at, perceived_exertion, notes)
VALUES (?, ?, ?, ?, ?, ?);

selectSetsForSession:
SELECT * FROM workout_set WHERE session_id = ? ORDER BY set_index ASC;

upsertSet:
INSERT OR REPLACE INTO workout_set(
  id, session_id, exercise_id, set_index, reps, weight_kg, duration_seconds, distance_metres, rir, completed
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSetsForSession:
DELETE FROM workout_set WHERE session_id = ?;
