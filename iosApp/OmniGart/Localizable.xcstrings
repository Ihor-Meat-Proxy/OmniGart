    "onboarding_energy_goal_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a wellness direction for estimated daily energy. You can change this later on the Food tab. If you have a health condition, are pregnant or under 18, check with a healthcare professional."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть wellness-напрям для орієнтовної денної енергії. Пізніше можна змінити на вкладці Їжа. За наявності стану здоров’я, вагітності чи віку до 18 зверніться до фахівця."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kierunek wellness dla szacowanej energii dziennej. Zmieńisz to później w zakładce Jedzenie. Przy chorobie, ciąży lub poniżej 18 lat skonsultuj się ze specjalistą."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Абярыце wellness-кірунак для арыентоўнай дзённай энергіі. Пазней можна змяніць на ўкладцы Ежа. Пры стане здароўя, цяжарнасці ці ўзросце да 18 звярніцеся да спецыяліста."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Болжалды күнделікті энергия үшін сауықтыру бағытын таңдаңыз. Кейін Тамақ қойындысында өзгерте аласыз. Денсаулық мәселесі, жүктілік немесе 18-ден кіші болса, маманмен кеңесіңіз."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ კეთილდღეობის მიმართულება სავარაუდო დღიური ენერგიისთვის. მოგვიანებით შეცვლით საკვების ჩანართში. ჯანმრთელობის მდგომარეობის, ორსულობის ან 18 წლამდე ასაკისას მიმართეთ სპეციალისტს."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una dirección de bienestar para la energía diaria estimada. Puedes cambiarla después en la pestaña Comida. Si tienes una condición de salud, estás embarazada o eres menor de 18, consulta a un profesional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une orientation bien-être pour l’énergie quotidienne estimée. Modifiable plus tard dans l’onglet Alimentation. En cas de problème de santé, de grossesse ou si vous avez moins de 18 ans, consultez un professionnel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Wellness-Richtung für die geschätzte Tagesenergie. Später unter Essen änderbar. Bei Gesundheitszustand, Schwangerschaft oder unter 18 Jahren bitte Fachperson fragen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte wellness směr pro odhadovanou denní energii. Později změníte na kartě Jídlo. Při zdravotním stavu, těhotenství nebo věku do 18 let se poraďte s odborníkem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为估计每日能量选择一个健康方向。之后可在“食物”标签中更改。如有健康状况、怀孕或未满 18 岁，请咨询专业人士。"
          }
        }
      }
    },
