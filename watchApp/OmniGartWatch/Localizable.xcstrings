    "perm_explainer_notifications_body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional reminders for workouts, hydration, and morning wellness check-ins. The app stays usable with notifications off."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язкові нагадування про тренування, гідратацію та ранкові перевірки самопочуття. Додаток працює зі вимкненими сповіщеннями."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne przypomnienia o treningach, nawodnieniu i porannych sprawdzeniach wellness. Aplikacja działa przy wyłączonych powiadomieniach."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Неабавязковыя нагадванні пра трэніроўкі, гідратацыю і ранішнія праверкі самаадчування. Дадатак працуе з выключанымі апавяшчэннямі."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаттығулар, су ішу және таңғы сауықтыру тексерулері үшін қосымша еске салғыштар. Қолданба хабарландырулар өшірілгенде де жұмыс істейді."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არასავალდებულო შეხსენებები ვარჯიშების, ჰიდრატაციისა და დილის კეთილდღეობის შემოწმებებისთვის. აპლიკაცია მუშაობს შეტყობინებების გამორთვისასაც."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios opcionales de entrenamientos, hidratación y comprobaciones matutinas de bienestar. La app sigue siendo usable con las notificaciones desactivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels facultatifs pour les entraînements, l’hydratation et les bilans de bien-être du matin. L’application reste utilisable avec les notifications désactivées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Erinnerungen für Workouts, Hydration und morgendliche Wellness-Checks. Die App bleibt mit deaktivierten Benachrichtigungen nutzbar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné připomínky tréninků, hydratace a ranních wellness kontrol. Aplikace zůstává použitelná s vypnutými oznámeními."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的训练、补水和晨间健康签到提醒。关闭通知后应用仍可使用。"
          }
        }
      }
    },
