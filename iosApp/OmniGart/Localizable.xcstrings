    "workout_intro": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Log strength sets for wellness training estimates. Figures are coaching aids, not medical advice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте силові сети для оцінок тренувань. Показники — тренерські підказки, а не медична консультація."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj serie siłowe na potrzeby szacunków treningu wellness. Wskaźniki to pomoce coachingowe, nie porada medyczna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запісвайце сілавыя сеты для ацэнак трэніровак. Паказчыкі — трэнерскія падказкі, а не медыцынская кансультацыя."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сауықтыру жаттығу бағалаулары үшін күш жиынтықтарын жазыңыз. Көрсеткіштер — жаттықтырушы көмектері, медициналық кеңес емес."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩაიწერეთ ძალის სეტები კეთილდღეობის ვარჯიშის შეფასებებისთვის. მაჩვენებლები — მწვრთნელის დახმარებაა, არა სამედიცინო რჩევა."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra series de fuerza para estimaciones de entrenamiento de bienestar. Las cifras son ayudas de coaching, no consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez des séries de force pour les estimations d’entraînement bien-être. Les chiffres sont des aides de coaching, pas un avis médical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokollieren Sie Kraftsätze für Wellness-Trainingsschätzungen. Kennzahlen sind Coaching-Hilfen, keine medizinische Beratung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenávejte silové série pro wellness tréninkové odhady. Údaje jsou koučovací pomůcky, nikoli lékařská rada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录力量组以获得健康训练估算。数值是教练辅助，不是医疗建议。"
          }
        }
      }
    },
