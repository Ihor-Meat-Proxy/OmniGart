    "watch.workout.summary.wellness": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellness summary — coaching reflection, not medical advice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумок самопочуття — тренерська рефлексія, не медична консультація."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsumowanie wellness — refleksja coachingowa, nie porada medyczna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вынік самаадчування — трэнерская рэфлексія, не медыцынская кансультацыя."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сауықтыру қорытындысы — жаттықтырушылық ой, медициналық кеңес емес."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კეთილდღეობის შეჯამება — სამწვრთნელო რეფლექსია, არა სამედიცინო რჩევა."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumen de bienestar — reflexión de coaching, no consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumé bien-être — réflexion coaching, pas un avis médical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellness-Zusammenfassung — Coaching-Reflexion, keine medizinische Beratung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Wellness souhrn — trenérská reflexe, ne lékařská rada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康摘要——教练反思，不是医疗建议。"
          }
        }
      }
    },
