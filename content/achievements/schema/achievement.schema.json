{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnigart.dev/schemas/achievement.schema.json",
  "title": "OmniGartAchievementCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "localePolicy", "healthyByDesign", "achievements"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "localePolicy": {
      "type": "array",
      "items": { "type": "string", "enum": ["en-GB", "uk"] },
      "minItems": 2,
      "uniqueItems": true
    },
    "healthyByDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rewardConsistency",
        "forbidCalorieRestrictionRewards",
        "forbidDehydrationOrExcessWaterRewards",
        "forbidTrainingThroughPoorRecoveryRewards",
        "forbidRapidWeightLossRewards",
        "weightAchievementsTrackLoggingOnly",
        "streaksAllowPlannedRestAndFreeze"
      ],
      "properties": {
        "rewardConsistency": { "type": "boolean", "const": true },
        "forbidCalorieRestrictionRewards": { "type": "boolean", "const": true },
        "forbidDehydrationOrExcessWaterRewards": { "type": "boolean", "const": true },
        "forbidTrainingThroughPoorRecoveryRewards": { "type": "boolean", "const": true },
        "forbidRapidWeightLossRewards": { "type": "boolean", "const": true },
        "weightAchievementsTrackLoggingOnly": { "type": "boolean", "const": true },
        "streaksAllowPlannedRestAndFreeze": { "type": "boolean", "const": true }
      }
    },
    "achievements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/achievement" }
    }
  },
  "$defs": {
    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "tier",
        "familyId",
        "hidden",
        "repeatable",
        "iconId",
        "titleKey",
        "descriptionKey",
        "rule",
        "sortOrder"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([._][a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 96
        },
        "category": {
          "type": "string",
          "enum": [
            "strength",
            "running",
            "swimming",
            "yoga",
            "pilates",
            "nutrition",
            "water",
            "recovery",
            "body_measurements",
            "consistency"
          ]
        },
        "tier": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "metal"],
              "properties": {
                "kind": { "const": "metal" },
                "metal": {
                  "type": "string",
                  "enum": ["bronze", "silver", "gold", "platinum"]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "level"],
              "properties": {
                "kind": { "const": "level" },
                "level": { "type": "integer", "minimum": 1, "maximum": 99 }
              }
            }
          ]
        },
        "familyId": {
          "type": "string",
          "pattern": "^[a-z0-9]+([._][a-z0-9]+)*$"
        },
        "hidden": { "type": "boolean" },
        "repeatable": { "type": "boolean" },
        "iconId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "titleKey": {
          "type": "string",
          "pattern": "^achievement\\.[a-z0-9_.]+\\.title$"
        },
        "descriptionKey": {
          "type": "string",
          "pattern": "^achievement\\.[a-z0-9_.]+\\.description$"
        },
        "rule": { "$ref": "#/$defs/rule" },
        "sortOrder": { "type": "integer", "minimum": 0 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "metric", "comparator", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["counter", "streak", "threshold", "personal_record", "challenge"]
        },
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "comparator": {
          "type": "string",
          "enum": ["gte", "gt", "lte", "lt", "eq"]
        },
        "value": { "type": "number" },
        "filters": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "count"],
          "properties": {
            "unit": {
              "type": "string",
              "enum": ["day", "week", "month", "rolling_days", "challenge"]
            },
            "count": { "type": "integer", "minimum": 1 }
          }
        },
        "streakPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowPlannedRest",
            "allowStreakFreeze",
            "maxFreezeDaysPer30Days"
          ],
          "properties": {
            "allowPlannedRest": { "type": "boolean" },
            "allowStreakFreeze": { "type": "boolean" },
            "maxFreezeDaysPer30Days": { "type": "integer", "minimum": 0, "maximum": 14 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "streak" } } },
          "then": { "required": ["streakPolicy"] }
        }
      ]
    }
  }
}
